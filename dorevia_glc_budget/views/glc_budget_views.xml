<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_budget_list" model="ir.ui.view">
        <field name="name">glc.budget.list</field>
        <field name="model">glc.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year"/>
                <field name="scenario"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_glc_budget_form" model="ir.ui.view">
        <field name="name">glc.budget.form</field>
        <field name="model">glc.budget</field>
        <field name="arch" type="xml">
            <form string="Budget prévisionnel GLC">
                <header>
                    <button name="action_validate" type="object" string="Valider"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reset_to_draft" type="object" string="Remettre en brouillon"
                            invisible="state != 'validated'" class="btn-secondary"/>
                    <button name="action_archive" type="object" string="Archiver"
                            invisible="state != 'validated'" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,archived"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="scenario" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="validated_by" readonly="1"/>
                            <field name="validated_date" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes budgétaires">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="period_date"/>
                                    <field name="line_type"/>
                                    <field name="analytic_account_id"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commentaire">
                            <field name="note" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_glc_budget_search" model="ir.ui.view">
        <field name="name">glc.budget.search</field>
        <field name="model">glc.budget</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="year"/>
                <field name="scenario"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_validated" string="Validé" domain="[('state', '=', 'validated')]"/>
                <filter name="filter_archived" string="Archivé" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter name="group_year" string="Année" context="{'group_by': 'year'}"/>
                <filter name="group_scenario" string="Scénario" context="{'group_by': 'scenario'}"/>
                <filter name="group_state" string="Statut" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_glc_budget_line_list" model="ir.ui.view">
        <field name="name">glc.budget.line.list</field>
        <field name="model">glc.budget.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="budget_id"/>
                <field name="period_date"/>
                <field name="line_type"/>
                <field name="analytic_account_id"/>
                <field name="amount"/>
                <field name="scenario"/>
                <field name="year"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_glc_budget_line_search" model="ir.ui.view">
        <field name="name">glc.budget.line.search</field>
        <field name="model">glc.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="budget_id"/>
                <field name="analytic_account_id"/>
                <field name="period_date"/>
                <field name="line_type"/>
                <field name="year"/>
                <field name="scenario"/>
                <filter name="filter_revenue" string="Recettes" domain="[('line_type', '=', 'revenue')]"/>
                <filter name="filter_expense" string="Charges" domain="[('line_type', '=', 'expense')]"/>
                <filter name="filter_funding" string="Financements" domain="[('line_type', '=', 'funding')]"/>
                <separator/>
                <filter name="group_period" string="Mois" context="{'group_by': 'period_date:month'}"/>
                <filter name="group_analytic" string="Axe analytique" context="{'group_by': 'analytic_account_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'line_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_glc_budget" model="ir.actions.act_window">
        <field name="name">Budgets prévisionnels</field>
        <field name="res_model">glc.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_glc_budget_search"/>
    </record>

    <record id="action_glc_budget_line" model="ir.actions.act_window">
        <field name="name">Lignes budgétaires</field>
        <field name="res_model">glc.budget.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_glc_budget_line_search"/>
    </record>

</odoo>
