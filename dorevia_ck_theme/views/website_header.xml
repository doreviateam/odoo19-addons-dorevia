<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phase 10 · GO §5undecies — habillage header CK -->
    <template id="layout_ck_header_chrome"
              inherit_id="website.layout"
              name="CK Theme header chrome"
              priority="25">
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-attf-class" add="ck-header o_hoverable_dropdown" separator=" "/>
            <attribute name="data-extra-items-toggle-aria-label">Plus de catégories</attribute>
        </xpath>
    </template>

    <!-- Sticky fiable — non-régression scroll MOA.
         QA C4 : ces règles DOUBLENT volontairement website_header.scss. Le SCSS
         seul ne suffit pas : Odoo applique au scroll un comportement de
         masquage/transform du header (classes dynamiques) qui ne peut être
         neutralisé de façon fiable que par un override !important injecté dans
         <head> (postérieur au bundle frontend). Toute modification du sticky doit
         être répercutée AUX DEUX endroits (ici + website_header.scss). -->
    <template id="layout_ck_header_sticky_critical"
              inherit_id="website.layout"
              name="CK Theme header sticky critical"
              priority="27">
        <xpath expr="//head" position="inside">
            <style>
                header#top.ck-header {
                    position: sticky !important;
                    top: 0 !important;
                    z-index: 1030;
                    transform: none !important;
                    opacity: 1 !important;
                    visibility: visible !important;
                    background-color: #ffffff !important;
                }
                header#top.ck-header.o_header_affixed,
                header#top.ck-header.o_header_is_scrolled,
                header#top.ck-header.o_transitioning.o_header_affixed {
                    background-color: #ffffff !important;
                }
            </style>
        </xpath>
    </template>

    <!-- Lot H1 — Strate 0 : bandeau service global Option A (toutes pages) -->
    <template id="layout_ck_header_service_bar"
              inherit_id="website.layout"
              name="CK Theme header service bar H1"
              priority="24">
        <xpath expr="//header[@id='top']" position="before">
            <div class="ck-header-service-bar"
                 role="region"
                 aria-label="Promesse C-Kréyòl">
                <div class="ck-header-service-bar__inner container-fluid">
                    <p class="ck-header-service-bar__text mb-0">
                        <span class="ck-header-service-bar__item">Produits créoles sélectionnés</span>
                        <span class="ck-header-service-bar__sep" aria-hidden="true">·</span>
                        <span class="ck-header-service-bar__item">Origines identifiées</span>
                        <span class="ck-header-service-bar__sep" aria-hidden="true">·</span>
                        <span class="ck-header-service-bar__item">Livraison suivie</span>
                    </p>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Logo typographique C-Kréyòl — remplace image générique website -->
    <template id="layout_ck_header_brand"
              inherit_id="website.option_header_brand_logo"
              name="CK Theme header brand text"
              priority="95">
        <xpath expr="//a[@data-name='Navbar Logo']" position="replace">
            <a data-name="Navbar Logo"
               href="/"
               t-attf-class="navbar-brand logo ck-header__brand-link #{_link_class}"
               aria-label="C-Kréyòl — Accueil">
                <span class="ck-header__brand" aria-hidden="true">
                    C-<span class="ck-header__brand-accent">Kréyòl</span>
                </span>
            </a>
        </xpath>
    </template>
</odoo>
