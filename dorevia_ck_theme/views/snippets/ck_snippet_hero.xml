<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_ck_hero" name="CK Hero">
        <section class="s_ck_hero ck-hero ck-hero--marketone-v1 o_colored_level" data-snippet="s_ck_hero" data-name="CK Hero V1">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-lg-7 o_editable">
                        <p class="ck-hero__kicker small text-uppercase fw-semibold text-muted mb-2">Boutique créole · Livraison France &amp; Europe</p>
                        <h1 class="ck-hero__title mb-3">Les saveurs créoles, prêtes à commander.</h1>
                        <p class="ck-hero__lead text-muted mb-4">
                            Épicerie, boissons, coffrets et bien-être — prix visibles, producteurs sélectionnés dans les territoires créolophones, achat en confiance.
                        </p>
                        <div class="d-flex flex-wrap gap-2 ck-hero__cta">
                            <a href="/shop" class="btn btn-primary">Voir la boutique</a>
                            <a href="/professionnels" class="btn btn-secondary">Espace professionnel</a>
                        </div>
                    </div>
                    <div class="col-lg-5 o_editable">
                        <div class="ck-hero__visual ck-hero__visual--editorial rounded overflow-hidden border d-flex align-items-center justify-content-center">
                            <span class="fa fa-shopping-basket fa-3x text-muted" aria-hidden="true"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
