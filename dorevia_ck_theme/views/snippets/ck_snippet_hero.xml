<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QA C2 : visuels par défaut servis par dorevia_ck_marketone_content
         (MOA sandbox — ck_hero_crepe_manioc / pate_manioc_2 / flag_market). -->
    <template id="s_ck_hero" name="CK Hero">
        <t t-set="ck_hero_content_ready"
           t-value="bool(request.env['ir.module.module'].sudo().search_count([('name', '=', 'dorevia_ck_marketone_content'), ('state', '=', 'installed')]))"/>
        <section class="s_ck_hero ck-hero ck-hero--marketone-v1 ck-grid-poc ck-grid-spread o_colored_level" data-snippet="s_ck_hero" data-name="CK Hero V1">
            <div class="container ck-grid-wrap">
                <div class="ck-guides" aria-hidden="true">
                    <div class="ck-guides__cols"/>
                    <div class="ck-guides__rows"/>
                    <div class="ck-guides__mline ck-guides__mline--l"/>
                    <div class="ck-guides__mline ck-guides__mline--r"/>
                </div>
                <div class="ck-grid">
                <div class="ck-hero__grid ck-grid-band">
                    <div class="ck-hero__content o_editable">
                        <p class="ck-hero__kicker">Boutique créole · Livraison France &amp; Europe</p>
                        <h1 class="ck-hero__title">Les saveurs créoles, prêtes à commander.</h1>
                        <p class="ck-hero__lead">
                            Épicerie, boissons, coffrets et bien-être — prix visibles, producteurs sélectionnés dans les territoires créolophones, achat en confiance.
                        </p>
                        <div class="ck-hero__cta">
                            <a href="/shop" class="btn btn-primary">Voir la boutique</a>
                            <a href="/professionnels" class="btn btn-secondary">Espace professionnel</a>
                        </div>
                    </div>
                    <div class="ck-hero__visual-col">
                        <div class="ck-hero__visual">
                            <div id="ckHeroVisualCarousel" class="carousel slide ck-hero__visual-carousel ck-hero__visual-carousel--multi" data-oe-protected="false" data-bs-ride="carousel" data-bs-interval="25000" data-bs-pause="hover">
                                <div class="carousel-indicators ck-hero__visual-indicators">
                                    <button type="button" data-bs-target="#ckHeroVisualCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Visuel 1"/>
                                    <button type="button" data-bs-target="#ckHeroVisualCarousel" data-bs-slide-to="1" aria-label="Visuel 2"/>
                                    <button type="button" data-bs-target="#ckHeroVisualCarousel" data-bs-slide-to="2" aria-label="Visuel 3"/>
                                </div>
                                <div class="carousel-inner">
                                    <div class="carousel-item active" data-snippet="s_ck_hero_slide" data-name="Visuel hero 1">
                                        <div class="ck-hero__slide-media o_editable">
                                            <p class="o_not_editable" contenteditable="false">
                                                <img t-attf-src="#{ck_hero_content_ready and '/dorevia_ck_marketone_content/static/img/ck_hero_crepe_manioc.webp' or '/dorevia_ck_theme/static/src/img/ck_hero_placeholder.svg'}" class="ck-hero__visual-media o_editable_media d-block w-100" t-attf-alt="#{ck_hero_content_ready and 'Galettes de manioc créoles dorées' or 'Visuel à remplacer via l\'éditeur Website Builder'}" width="800" height="500" loading="eager"/>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="carousel-item" data-snippet="s_ck_hero_slide" data-name="Visuel hero 2">
                                        <div class="ck-hero__slide-media o_editable">
                                            <p class="o_not_editable" contenteditable="false">
                                                <img t-attf-src="#{ck_hero_content_ready and '/dorevia_ck_marketone_content/static/img/ck_hero_pate_manioc_2.webp' or '/dorevia_ck_theme/static/src/img/ck_hero_placeholder.svg'}" class="ck-hero__visual-media o_editable_media d-block w-100" t-attf-alt="#{ck_hero_content_ready and 'Pâte de manioc créole — tradition et savoir-faire' or 'Visuel à remplacer via l\'éditeur Website Builder'}" width="800" height="500" loading="lazy"/>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="carousel-item" data-snippet="s_ck_hero_slide" data-name="Visuel hero 3">
                                        <div class="ck-hero__slide-media o_editable">
                                            <p class="o_not_editable" contenteditable="false">
                                                <img t-attf-src="#{ck_hero_content_ready and '/dorevia_ck_marketone_content/static/img/ck_hero_flag_market.webp' or '/dorevia_ck_theme/static/src/img/ck_hero_placeholder.svg'}" class="ck-hero__visual-media o_editable_media d-block w-100" t-attf-alt="#{ck_hero_content_ready and 'Marché créole — sélection CK' or 'Visuel à remplacer via l\'éditeur Website Builder'}" width="800" height="500" loading="lazy"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <button type="button"
                                        class="ck-hero__visual-pause"
                                        aria-pressed="false"
                                        aria-label="Mettre en pause le défilement automatique des visuels">
                                    <i class="fa fa-pause" aria-hidden="true"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
