<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_ck_hero" name="CK Hero">
        <section class="s_ck_hero ck-hero pt64 pb64" data-snippet="s_ck_hero">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-lg-6 o_editable">
                        <h1 class="ck-hero__title mb-3">Produits créoles, du producteur à votre table</h1>
                        <p class="ck-hero__lead lead mb-4">
                            Agro-transformation, épicerie fine et bien-être — sélection C-Kreyol Marketone.
                        </p>
                        <a href="/shop" class="btn btn-primary btn-lg">Découvrir la boutique</a>
                    </div>
                    <div class="col-lg-6 o_editable">
                        <img src="/web/image/website.s_cover_default_image"
                             class="img-fluid rounded ck-hero__image w-100"
                             alt=""/>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
