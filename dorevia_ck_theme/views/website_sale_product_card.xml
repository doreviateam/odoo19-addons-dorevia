<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Socle card CK Home/Boutique — voir product_card.scss et home_featured.py -->
    <template id="products_item_ck_card"
              inherit_id="website_sale.products_item"
              name="CK Shop product card"
              priority="40">

        <xpath expr="//form[contains(@t-attf-class, 'oe_product_cart')]" position="attributes">
            <attribute name="t-attf-class" add="ck-product-card ck-product-card--shop ck-product-card--interactive product-card flex-column" separator=" "/>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'oe_product_image')]" position="attributes">
            <attribute name="t-attf-class" add="ck-product-card__image product-card-media ck-product-card__media" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('oe_subdescription_wrapper')]" position="replace"/>

        <xpath expr="//div[hasclass('o_wsale_product_information_text')]" position="attributes">
            <attribute name="class" add="ck-product-card__body product-card-body" separator=" "/>
        </xpath>

        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="attributes">
            <attribute name="class" add="ck-product-card__title product-card-title h6 mb-0" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="attributes">
            <attribute name="class" add="ck-product-card__foot product-card-foot" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_product_sub')]//div[hasclass('product_price')]" position="attributes">
            <attribute name="class" add="ck-product-card__price product-card-pricing" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('product_price')]//span[hasclass('fw-bold')]" position="attributes">
            <attribute name="class" add="ck-product-card__price-value price" separator=" "/>
            <attribute name="class" remove="fw-bold" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="attributes">
            <attribute name="class" add="ck-product-card__actions product-card-actions" separator=" "/>
        </xpath>
    </template>

    <!-- Polish-U2 — Rubans grille Shop : classes CK + pas de style inline BO. -->
    <template id="products_item_ck_card_ribbon"
              inherit_id="website_sale.products_item"
              name="CK Shop product card ribbon"
              priority="46">
        <xpath expr="//span[@t-att-data-ribbon-id='ribbon.id']" position="replace">
            <span t-if="ribbon"
                  t-att-data-ribbon-id="ribbon.id"
                  t-attf-class="o_ribbons o_not_editable ck-product-card__badge badge badge-float #{ribbon.sudo().get_ck_card_badge_class()}"
                  t-out="ribbon.name or ''"/>
        </xpath>
    </template>

    <!-- Rating-U2/U3 — Note compacte (★ 4,8 · 12 avis), socle partagé cards Home/Boutique + fiche produit.
         Conditionnel : rien si rating_count == 0 → pas de fausse note / espace mort.
         Formatage FR : '%g' supprime le trailing zero (5.0 → 5). -->
    <template id="ck_compact_rating_widget" name="CK Compact rating widget (★ 4,8 · N avis)">
        <!-- sudo: product.template — visiteur public peut lire la note moyenne (canon Odoo 19 tile) -->
        <t t-if="ck_rating_product.rating_count > 0">
            <t t-set="ck_rating_fmt" t-value="('%g' % round(ck_rating_product.sudo().rating_avg, 1)).replace('.', ',')"/>
            <div class="ck-card-rating">
                <span class="ck-rating-star" aria-hidden="true">★</span>
                <span class="visually-hidden">Note </span>
                <span class="ck-rating-value" t-esc="ck_rating_fmt"/>
                <span class="visually-hidden"> sur 5</span>
                <span class="ck-rating-separator" aria-hidden="true"> · </span>
                <span class="ck-rating-count"><t t-esc="ck_rating_product.rating_count"/> avis</span>
            </div>
        </t>
    </template>

    <!-- Rating-U2 — Note compacte sur cards shop. XPath sur o_wsale_product_information_text (natif Odoo 19, fiable). -->
    <template id="products_item_ck_card_rating"
              inherit_id="website_sale.products_item"
              name="CK Shop product card rating"
              priority="48">
        <xpath expr="//div[hasclass('o_wsale_product_information_text')]" position="inside">
            <t t-call="dorevia_ck_theme.ck_compact_rating_widget">
                <t t-set="ck_rating_product" t-value="product"/>
            </t>
        </xpath>
    </template>

    <template id="shop_product_buttons_ck_card"
              inherit_id="website_sale.shop_product_buttons"
              name="CK Shop product card cart CTA"
              priority="40">
        <xpath expr="//button[hasclass('o_wsale_product_btn_primary')]" position="attributes">
            <attribute name="class" add="card-cart-cta" separator=" "/>
            <attribute name="aria-label">Ajouter au panier</attribute>
            <attribute name="title">Ajouter au panier</attribute>
        </xpath>
        <!-- CTA unifié Home/Shop — libellé visible (canon Coups de cœur). -->
        <xpath expr="//button[hasclass('o_wsale_product_btn_primary')]//span[hasclass('o_label')]" position="replace">
            <span class="o_label card-cart-cta__label">Ajouter au panier</span>
        </xpath>
    </template>
</odoo>
