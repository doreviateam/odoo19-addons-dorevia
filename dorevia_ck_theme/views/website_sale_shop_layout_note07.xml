<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Note 07 · Lot A — Boutique pleine largeur + drawer filtres.
         Héritages xpath légers sur website_sale.products (priority 40).
         Contrainte : form.js_attributes conservé dans l'offcanvas natif Odoo —
         ne pas déplacer ni réécrire le formulaire de filtrage. -->
    <template id="products_ck_note07_layout"
              inherit_id="website_sale.products"
              name="CK Shop Note07 — grille pleine largeur + drawer filtres"
              priority="40">

        <!-- A1 : sidebar masquée — l'offcanvas natif porte les filtres.
             Native class = "d-none d-lg-block" ; on retire d-lg-block (display:block !important
             au-dessus de d-none en desktop car Bootstrap charge les resp. utilities après). -->
        <xpath expr="//aside[@id='products_grid_before']" position="attributes">
            <attribute name="class" remove="d-lg-block" separator=" "/>
        </xpath>
    </template>
</odoo>
