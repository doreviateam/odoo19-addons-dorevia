<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="marketone_page_shop"
              inherit_id="website_sale.products"
              name="Marketone: Boutique /shop"
              priority="16">
        <xpath expr="//t[@t-set='opt_wsale_categories']" position="replace">
            <t t-set="opt_wsale_categories" t-value="True"/>
        </xpath>
        <!-- Filmstrip horizontal : masqué — catégories = sidebar uniquement (MOA). -->
        <xpath expr="//t[@t-set='opt_wsale_categories_top']" position="replace">
            <t t-set="opt_wsale_categories_top" t-value="False"/>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="marketone-shop" separator=" "/>
        </xpath>
        <!-- Cover natif Odoo 19 — renfort fill-mode grille (complète surcharge .oe_product_cart). -->
        <xpath expr="//section[@id='o_wsale_products_grid']" position="attributes">
            <attribute name="class" add="o_wsale_products_opt_thumb_cover" separator=" "/>
        </xpath>
    </template>
</odoo>
