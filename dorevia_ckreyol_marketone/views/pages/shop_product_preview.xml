<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- UX-4 Lot 3 — coque offcanvas desktop (non modal). -->
    <template id="marketone_shop_preview_offcanvas_shell"
              inherit_id="website_sale.products"
              name="Marketone: preview Voir — offcanvas desktop"
              priority="57">
        <xpath expr="//div[@id='wrap']" position="inside">
            <div id="marketone_shop_preview_offcanvas"
                 class="offcanvas offcanvas-end marketone-shop-preview-offcanvas"
                 data-bs-scroll="true"
                 data-bs-backdrop="false"
                 tabindex="-1"
                 aria-labelledby="marketone_shop_preview_offcanvas_title">
                <div class="offcanvas-header marketone-shop-preview-offcanvas__header">
                    <h2 id="marketone_shop_preview_offcanvas_title"
                        class="offcanvas-title marketone-shop-preview-offcanvas__title">
                        Aperçu produit
                    </h2>
                    <button type="button"
                            class="btn-close marketone-shop-preview-offcanvas__close"
                            data-bs-dismiss="offcanvas"
                            aria-label="Fermer"/>
                </div>
                <div class="offcanvas-body marketone-shop-preview-offcanvas__body"/>
            </div>
        </xpath>
    </template>

    <!-- Fragment injecté via /shop/product/preview/<id> -->
    <template id="marketone_shop_product_preview_fragment"
              name="Marketone: fragment preview produit">
        <div class="marketone-shop-preview"
             t-att-data-product-template-id="product.id">
            <div class="marketone-shop-preview__media">
                <span t-field="product.image_1920"
                      t-options="{'widget': 'image', 'preview_image': 'image_1024', 'class': 'marketone-shop-preview__img w-100'}"/>
            </div>
            <div class="marketone-shop-preview__body">
                <h3 class="marketone-shop-preview__title" t-out="product.name"/>
                <div class="marketone-shop-preview__price" aria-label="Prix">
                    <span class="fw-bold"
                          t-out="combination_info['price']"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </div>
                <div t-if="origin_lines" class="marketone-shop-preview__origins">
                    <span class="marketone-shop-preview__meta-label">Origines</span>
                    <ul class="marketone-shop-preview__meta-list list-inline mb-0">
                        <li t-foreach="origin_lines"
                            t-as="line"
                            class="list-inline-item">
                            <span t-out="line['label']"/>
                        </li>
                    </ul>
                </div>
                <div t-if="category_labels" class="marketone-shop-preview__collections">
                    <span class="marketone-shop-preview__meta-label">Collections</span>
                    <span class="marketone-shop-preview__meta-text"
                          t-out="', '.join(category_labels)"/>
                </div>
                <p t-if="product.description_sale"
                   class="marketone-shop-preview__description text-muted"
                   t-out="product.description_sale"/>
                <form class="oe_product_cart marketone-shop-preview__actions"
                      t-att-data-marketone-no-variant-ptav-ids="','.join(map(str, product._marketone_grid_no_variant_ptav_ids()))">
                    <input type="hidden" name="product_id" t-att-value="product_variant.id"/>
                    <input type="hidden" name="product_template_id" t-att-value="product.id"/>
                    <input type="hidden" name="product_type" t-att-value="product.type"/>
                    <div class="marketone-shop-preview__cta-row">
                        <button type="button"
                                class="marketone-shop-card-cart btn btn-primary o_wsale_product_btn_primary"
                                data-show-quantity="false"
                                aria-label="Ajouter au panier"
                                title="Ajouter au panier">
                            <i class="fa fa-fw fa-shopping-cart o_not-animable" aria-hidden="true"/>
                            <span class="o_label small ms-1">Ajouter au panier</span>
                        </button>
                        <t t-set="in_wish" t-value="product._is_in_wishlist()"/>
                        <button type="button"
                                role="button"
                                t-attf-class="marketone-shop-card-wishlist btn #{in_wish and 'o_in_wishlist is-active'}"
                                t-att-data-product-template-id="product.id"
                                t-att-data-product-product-id="product_variant.id"
                                data-action="o_wishlist"
                                t-att-aria-pressed="'true' if in_wish else 'false'"
                                t-att-title="'Retirer de la liste' if in_wish else 'Ajouter à la liste'"
                                t-att-aria-label="'Retirer de la liste' if in_wish else 'Ajouter à la liste'">
                            <i t-attf-class="fa #{in_wish and 'fa-heart' or 'fa-heart-o'} o_not-animable"
                               aria-hidden="true"/>
                        </button>
                    </div>
                </form>
                <a t-att-href="product_href"
                   class="marketone-shop-preview__full-link">
                    Voir la fiche complète
                </a>
            </div>
        </div>
    </template>
</odoo>
