<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- UX-1 : reset global uniquement dans la barre chips (shop_filter_state.xml). -->
    <template id="marketone_shop_clear_filters"
              inherit_id="website_sale.products"
              name="Marketone: masquer Clear Filters sidebar (UX-1)"
              priority="24">
        <xpath expr="//aside[@id='products_grid_before']//div[hasclass('py-3')][hasclass('border-bottom')][.//i[hasclass('oi-close')]]" position="replace"/>
    </template>

    <template id="marketone_shop_clear_filters_offcanvas"
              inherit_id="website_sale.o_wsale_offcanvas"
              name="Marketone: masquer Clear Filters offcanvas (UX-1)"
              priority="24">
        <xpath expr="//aside[@id='o_wsale_offcanvas']//div[hasclass('border-top')]/a" position="replace"/>
    </template>
</odoo>
