<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sidebar /shop : facette multi-catégories principales (OU) — TICKET sidebar filtres. -->
    <template id="marketone_products_categories_primary_list"
              inherit_id="website_sale.products_categories_list"
              name="Marketone: catégories principales sidebar"
              priority="32">
        <xpath expr="//div[@t-attf-class='d-contents']" position="replace">
            <t>
                <t t-set="marketone_primary_public_categories"
                   t-value="marketone_primary_public_categories or request.env['product.public.category']._marketone_primary_public_categories(website=website)"/>
                <t t-set="marketone_active_cat_slugs"
                   t-value="marketone_shop_sidebar_active_category_slugs or []"/>
                <!-- Ouvert par défaut ; replié si facette vide après interaction. -->
                <t t-set="marketone_cat_expand" t-value="True"/>
                <t t-if="isOffcanvas">
                    <div name="wsale_products_categories_list" t-attf-class="wsale_products_categories_list">
                        <t t-call="dorevia_ckreyol_marketone.marketone_primary_category_checks"/>
                    </div>
                </t>
                <t t-else="">
                    <div class="accordion accordion-flush marketone-shop-categories-accordion w-100">
                        <div class="accordion-item nav-item mb-1 rounded-0 border-0">
                            <div id="marketone_wsale_primary_categories_header"
                                 class="accordion-header h6 mb-0">
                                <button type="button"
                                        t-attf-class="accordion-button px-0 bg-transparent shadow-none #{'collapsed' if not marketone_cat_expand else ''}"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#marketone_wsale_primary_categories"
                                        aria-controls="marketone_wsale_primary_categories"
                                        t-att-aria-expanded="'true' if marketone_cat_expand else 'false'">
                                    <b>Catégories</b>
                                </button>
                            </div>
                            <div id="marketone_wsale_primary_categories"
                                 t-attf-class="accordion-collapse collapse{{ ' show' if marketone_cat_expand else '' }}"
                                 aria-labelledby="marketone_wsale_primary_categories_header"
                                 data-bs-parent=".marketone-shop-categories-accordion">
                                <div class="accordion-body pt-0 pb-0 px-0">
                                    <t t-call="dorevia_ckreyol_marketone.marketone_primary_category_checks"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <template id="marketone_primary_category_checks" name="Marketone: cases catégories principales">
        <div class="flex-column mb-3 marketone-sidebar-catchecks">
            <t t-foreach="marketone_primary_public_categories" t-as="c">
                <t t-set="marketone_cat_slug" t-value="slug(c)"/>
                <t t-set="marketone_cat_checked"
                   t-value="marketone_cat_slug in marketone_active_cat_slugs"/>
                <div class="">
                    <div class="form-check mb-1">
                        <label class="form-check-label d-flex align-items-center gap-2 w-100 mb-0 fw-normal">
                            <input type="checkbox"
                                   class="form-check-input flex-shrink-0 marketone-sidebar-cat-check"
                                   t-att-id="'marketone_cat_%s' % c.id"
                                   t-att-data-category-slug="marketone_cat_slug"
                                   t-att-checked="marketone_cat_checked and 'checked' or None"
                                   t-att-data-publish="c.has_published_products and 'on' or 'off'"/>
                            <span t-field="c.name"/>
                        </label>
                    </div>
                </div>
            </t>
        </div>
    </template>
</odoo>
