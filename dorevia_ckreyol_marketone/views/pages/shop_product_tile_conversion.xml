<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tuile /shop conversion MOA — photo pleine, wishlist overlay, titre 2 lignes,
         ligne basse Voir (gauche) + prix (droite), panier au survol image.
         Scope : organisation visuelle uniquement — doctrine image v2 inchangée. -->
    <template id="marketone_products_item_conversion"
              inherit_id="website_sale.products_item"
              name="Marketone: tuile /shop — conversion (titre, prix, CTA, wishlist)"
              priority="55">

        <!-- Wishlist overlay — coin supérieur droit (standard Odoo o_add_wishlist, toggle UX-4). -->
        <xpath expr="//div[contains(@t-attf-class, 'oe_product_image')]" position="inside">
            <div class="marketone-shop-card-wishlist-wrap">
                <t>
                    <t t-set="in_wish" t-value="product._is_in_wishlist()"/>
                    <t t-set="product_variant_id"
                       t-value="product._get_first_possible_variant_id()"/>
                    <button t-if="product_variant_id"
                            type="button"
                            role="button"
                            t-attf-class="marketone-shop-card-wishlist btn #{in_wish and 'o_in_wishlist is-active'}"
                            t-att-data-product-template-id="product.id"
                            t-att-data-product-product-id="product_variant_id"
                            data-action="o_wishlist"
                            t-att-aria-pressed="'true' if in_wish else 'false'"
                            t-att-title="'Retirer de la liste' if in_wish else 'Ajouter à la liste'"
                            t-att-aria-label="'Retirer de la liste' if in_wish else 'Ajouter à la liste'">
                        <i t-attf-class="fa #{in_wish and 'fa-heart' or 'fa-heart-o'} o_not-animable"
                           aria-hidden="true"/>
                    </button>
                </t>
            </div>
        </xpath>

        <!-- Panier — déplacé sur la zone photo (survol / action explicite). -->
        <xpath expr="//div[contains(@t-attf-class, 'oe_product_image')]" position="inside">
            <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="move"/>
        </xpath>

        <!-- UX-4 Lot 3quater bis — feedback panier : overlay image (desktop) · inline corps (mobile). -->
        <xpath expr="//div[contains(@t-attf-class, 'oe_product_image')]" position="inside">
            <div class="marketone-shop-card-cart-feedback marketone-shop-card-cart-feedback--tile"
                 hidden="hidden"
                 aria-live="polite">
                <span class="marketone-shop-card-cart-feedback__label d-inline d-lg-none">Ajouté au panier</span>
                <a href="/shop/cart"
                   class="marketone-shop-card-cart-feedback__link">Voir le panier</a>
            </div>
        </xpath>

        <!-- UX-4 Lot 2 / 3ter — PTAV panier + data preview carte (clic image). -->
        <xpath expr='//form[contains(@t-attf-class, "oe_product_cart")]' position="attributes">
            <attribute name="t-att-data-marketone-no-variant-ptav-ids">",".join(map(str, product._marketone_grid_no_variant_ptav_ids()))</attribute>
            <attribute name="t-att-data-product-template-id">product.id</attribute>
            <attribute name="t-att-data-marketone-preview-allowed">product._marketone_preview_full_allowed()</attribute>
        </xpath>

        <!-- UX-4 Lot 3 — emplacement preview mobile inline. -->
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="after">
            <div class="marketone-shop-card-preview-slot d-lg-none"
                 hidden="hidden"
                 aria-live="polite"/>
        </xpath>

        <!-- Suppression description courte (description_sale) -->
        <xpath expr="//div[hasclass('oe_subdescription_wrapper')]" position="replace"/>

        <!-- Titre — hauteur 2 lignes réservée -->
        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="attributes">
            <attribute name="class" add="marketone-shop-card-title" separator=" "/>
        </xpath>

        <!-- UX-4 Lot 2 — feedback local carte après ajout panier. -->
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="attributes">
            <attribute name="class" add="marketone-shop-card-footer" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_product_sub')]/*[1]" position="before">
            <a t-att-href="product_href"
               class="marketone-shop-card-cta"
               t-att-data-product-template-id="product.id"
               t-att-data-marketone-preview-allowed="product._marketone_preview_full_allowed()"
               aria-expanded="false"
               aria-label="Voir le produit"
               title="Voir">Voir</a>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_product_sub')]//div[hasclass('product_price')]"
               position="attributes">
            <attribute name="class" add="marketone-shop-card-price" separator=" "/>
        </xpath>
    </template>

    <!-- UX-4 Lot 2 / 3quater — handler grille + CTA panier tuile explicite (icône + Ajouter). -->
    <template id="marketone_shop_product_buttons_cart"
              inherit_id="website_sale.shop_product_buttons"
              name="Marketone panier grille UX-4 Lot 2 / 3quater"
              priority="56">
        <xpath expr="//button[hasclass('o_wsale_product_btn_primary')]" position="attributes">
            <attribute name="class" remove="a-submit" add="marketone-shop-card-cart marketone-shop-card-cart--tile" separator=" "/>
            <attribute name="aria-label">Ajouter au panier</attribute>
            <attribute name="title">Ajouter au panier</attribute>
            <attribute name="t-att-data-show-quantity">False</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_wsale_product_btn_primary')]//span[hasclass('o_label')]" position="replace">
            <span class="o_label marketone-shop-card-cart__label">Ajouter</span>
        </xpath>
    </template>
</odoo>
