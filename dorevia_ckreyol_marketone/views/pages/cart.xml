<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scope panier / checkout via checkout_layout (cart, address, payment Odoo 19). -->
    <template id="marketone_checkout_layout_scope"
              inherit_id="website_sale.checkout_layout"
              name="Marketone: Scope panier / checkout"
              priority="16">
        <xpath expr="//t[@t-set='body_classname'][@t-value=&quot;'o_website_sale_checkout'&quot;]" position="before">
            <t t-set="marketone_scope" t-value="(
                'marketone-checkout'
                if any(p in request.httprequest.path for p in ('/shop/checkout', '/shop/address', '/shop/payment'))
                else ('marketone-cart' if '/shop/cart' in request.httprequest.path else '')
            )"/>
        </xpath>
        <xpath expr="//t[@t-set='body_classname'][@t-value=&quot;'o_website_sale_checkout'&quot;]" position="replace">
            <t t-set="body_classname" t-value="'o_website_sale_checkout' + (' ' + marketone_scope if marketone_scope else '')"/>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="" separator=" ">
                <t t-esc="marketone_scope or ''"/>
            </attribute>
        </xpath>
    </template>
</odoo>
