<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- UX-2 — Sidebar : classes rail + facettes ouvertes par défaut (desktop). -->
  <template id="marketone_shop_sidebar_ux2_rail_class"
            inherit_id="website_sale.products"
            name="Marketone UX-2: classe rail sidebar"
            priority="34">
    <xpath expr="//aside[@id='products_grid_before']//div[hasclass('o_wsale_products_grid_before_rail')]" position="attributes">
      <attribute name="class" add="marketone-sidebar-rail" separator=" "/>
    </xpath>
  </template>

  <template id="marketone_shop_sidebar_ux2_expand_attributes"
            inherit_id="website_sale.product_attribute_filters_form"
            name="Marketone UX-2: facettes attributs ouvertes par défaut"
            priority="34">
    <xpath expr="//t[@t-set='_expand_attributes']" position="attributes">
      <attribute name="t-value">True</attribute>
    </xpath>
  </template>

  <!-- Tablette (≥768px) : sidebar en colonne (pas seulement offcanvas). -->
  <template id="marketone_shop_sidebar_visible_from_tablet"
            inherit_id="website_sale.products"
            name="Marketone UX-2: sidebar visible dès md"
            priority="35">
    <xpath expr="//aside[@id='products_grid_before']" position="attributes">
      <attribute name="class" remove="d-lg-block" separator=" "/>
      <attribute name="class" add="d-md-block" separator=" "/>
    </xpath>
  </template>
</odoo>
