<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="marketone_shop_origin_view_tree" model="ir.ui.view">
        <field name="name">marketone.shop.origin.tree</field>
        <field name="model">marketone.shop.origin</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name_visitor"/>
                <field name="slug"/>
                <field name="attribute_value_id"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="marketone_shop_origin_view_form" model="ir.ui.view">
        <field name="name">marketone.shop.origin.form</field>
        <field name="model">marketone.shop.origin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name_visitor"/>
                        <field name="slug"/>
                        <field name="attribute_value_id"/>
                        <field name="context_phrase"/>
                        <field name="sequence"/>
                        <field name="website_id" groups="website.group_multi_website"/>
                        <field name="website_published"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketone_shop_origin" model="ir.actions.act_window">
        <field name="name">Origines Marketone</field>
        <field name="res_model">marketone.shop.origin</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_marketone_shop_origin"
              name="Origines (porte shop)"
              parent="website.menu_website_configuration"
              action="action_marketone_shop_origin"
              sequence="95"
              groups="website.group_website_designer"/>
</odoo>
