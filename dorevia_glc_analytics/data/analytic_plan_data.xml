<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Plan analytique unique GLC — activités opérationnelles et axes financement.
            Applicabilités non bloquantes (Palier 0).
        -->
        <record id="analytic_plan_glc_activites" model="account.analytic.plan">
            <field name="name">GLC - Activités</field>
            <field name="description">Pilotage GLC — activités, ressources et structure.</field>
            <field name="default_applicability">optional</field>
            <field name="applicability_ids" eval="[
                (0, 0, {'business_domain': 'bill', 'applicability': 'optional'}),
                (0, 0, {'business_domain': 'invoice', 'applicability': 'optional'}),
            ]"/>
        </record>

    </data>
</odoo>
