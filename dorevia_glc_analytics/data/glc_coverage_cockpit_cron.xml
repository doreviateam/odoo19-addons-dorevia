<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_glc_coverage_cockpit_refresh" model="ir.cron">
        <field name="name">GLC — Actualisation des cockpits de couverture</field>
        <field name="model_id" ref="model_glc_coverage_cockpit"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_cockpits()</field>
        <field name="user_id" ref="base.user_root"/>
