<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dorevia_glc_analytics.GlcCoverageSynthesis">
        <div class="o_glc_coverage_synthesis">
            <t t-set="agg" t-value="aggregates"/>
            <t t-if="agg.hasLines">
                <div class="o_glc_kpi_row d-flex flex-wrap gap-3 mb-4">
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Solde réel</div>
                        <div t-att-class="'o_glc_kpi_value ' + signedClass(agg.periodTotals.performance_realized)"
                             t-esc="formatSignedAmount(agg.periodTotals.performance_realized)"/>
                        <div class="o_glc_kpi_hint">solde période</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Solde budget</div>
                        <div t-att-class="'o_glc_kpi_value ' + budgetKpiClass()"
                             t-esc="formatBudgetKpi(agg.periodTotals.performance_budget)"/>
                        <div class="o_glc_kpi_hint">
                            <t t-if="hasPeriodBudget">prévu sur la période</t>
                            <t t-else="">aucun budget sur la période</t>
                        </div>
                    </div>
                    <div t-if="hasPeriodBudget" class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Écart de solde</div>
                        <div t-att-class="'o_glc_kpi_value ' + signedClass(agg.periodTotals.variance_performance)"
                             t-esc="formatSignedAmount(agg.periodTotals.variance_performance)"/>
                        <div class="o_glc_kpi_hint">réel − budget</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Ressources totales</div>
                        <div class="o_glc_kpi_value o_glc_kpi_positive"
                             t-esc="formatAmount(resourcesRealized)"/>
                        <div class="o_glc_kpi_hint">recette + financements</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Ressources facturées</div>
                        <div t-att-class="'o_glc_kpi_value ' + documentQualityClass(revenueInvoicedRate, revenueEligibleAmount)"
                             t-esc="formatDocumentQualityRate(revenueInvoicedRate, revenueEligibleAmount)"/>
                        <div class="o_glc_kpi_hint">part des ressources issues de factures client</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Dépenses facturées</div>
                        <div t-att-class="'o_glc_kpi_value ' + documentQualityClass(expenseInvoicedRate, expenseEligibleAmount)"
                             t-esc="formatDocumentQualityRate(expenseInvoicedRate, expenseEligibleAmount)"/>
                        <div class="o_glc_kpi_hint">part des dépenses issues de factures fournisseur</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Couverture du Cumul RH</div>
                        <div t-att-class="'o_glc_kpi_value ' + coverageClass(agg.salaryCoverageRate)"
                             t-esc="formatCoverageRate(agg.salaryCoverageRate)"/>
                        <div class="o_glc_kpi_hint">ressources / cumul RH × 100</div>
                    </div>
                </div>

                <div class="o_glc_chart_grid">
                    <div class="o_glc_chart_block">
                        <h6 class="o_glc_chart_title">Solde mensuel — réel vs budget</h6>
                        <div class="o_glc_chart_canvas_wrapper">
                            <canvas t-ref="perfChart"/>
                        </div>
                    </div>

                    <div class="o_glc_chart_block">
                        <h6 class="o_glc_chart_title d-flex align-items-center gap-1 mb-2">
                            <span>Structure mensuelle — Ressource / Cumul RH / Dépense</span>
                            <span class="o_glc_chart_help"
                                  title="Barres : masses mensuelles (Ressource, Cumul RH, Dépense). Courbe : solde net du mois (Ressource − Cumul RH − Dépense).">
                                ⓘ
                            </span>
                        </h6>
                        <div class="o_glc_chart_canvas_wrapper">
                            <canvas t-ref="structChart"/>
                        </div>
                    </div>

                    <div class="o_glc_chart_block">
                        <h6 class="o_glc_chart_title">Solde par axe analytique — cumul période</h6>
                        <div class="o_glc_chart_canvas_wrapper o_glc_chart_activity">
                            <canvas t-ref="activityChart"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
