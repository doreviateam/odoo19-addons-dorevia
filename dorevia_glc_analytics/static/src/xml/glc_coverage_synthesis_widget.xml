<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dorevia_glc_analytics.GlcCoverageSynthesis">
        <div class="o_glc_coverage_synthesis">
            <t t-set="agg" t-value="aggregates"/>
            <t t-if="agg.hasLines">
                <div class="o_glc_kpi_row d-flex flex-wrap gap-3 mb-4">
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Solde</div>
                        <div t-att-class="'o_glc_kpi_value ' + signedClass(agg.periodTotals.performance_realized)"
                             t-esc="formatSignedAmount(agg.periodTotals.performance_realized)"/>
                        <div class="o_glc_kpi_hint">Ressources − Cumul RH − Dépenses</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Ressources</div>
                        <div class="o_glc_kpi_value o_glc_kpi_positive"
                             t-esc="formatAmount(resourcesRealized)"/>
                        <div class="o_glc_kpi_hint">total réalisé période</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Charges de structure</div>
                        <div class="o_glc_kpi_value o_glc_kpi_neutral"
                             t-esc="formatAmount(totalExpensesRealized)"/>
                        <div class="o_glc_kpi_hint">cumul RH + dépenses</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Couverture du Cumul RH</div>
                        <div t-att-class="'o_glc_kpi_value ' + coverageClass(agg.salaryCoverageRate)"
                             t-esc="formatCoverageRate(agg.salaryCoverageRate)"/>
                        <div class="o_glc_kpi_hint">ressources / cumul RH × 100</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Taux lettrage clients</div>
                        <div t-att-class="'o_glc_kpi_value ' + reconcileClass(reconcileRateCustomer)"
                             t-esc="formatReconcileRate(reconcileRateCustomer)"/>
                        <div class="o_glc_kpi_hint">stock clients lettré fin période</div>
                    </div>
                    <div class="o_glc_kpi_card flex-fill">
                        <div class="o_glc_kpi_label">Taux lettrage fournisseurs</div>
                        <div t-att-class="'o_glc_kpi_value ' + reconcileClass(reconcileRateSupplier)"
                             t-esc="formatReconcileRate(reconcileRateSupplier)"/>
                        <div class="o_glc_kpi_hint">stock fournisseurs lettré fin période</div>
                    </div>
                </div>

                <div class="o_glc_chart_grid">
                    <div class="o_glc_chart_block">
                        <h6 class="o_glc_chart_title">Solde mensuel</h6>
                        <div class="o_glc_chart_canvas_wrapper">
                            <canvas t-ref="perfChart"/>
                        </div>
                    </div>

                    <div class="o_glc_chart_block">
                        <h6 class="o_glc_chart_title d-flex align-items-center gap-1 mb-2">
                            <span>Structure mensuelle — Ressources / Cumul RH / Dépenses</span>
                            <span class="o_glc_chart_help"
                                  title="Barres : masses mensuelles. Courbe : solde du mois (Ressources − Cumul RH − Dépenses).">
                                ⓘ
                            </span>
                        </h6>
                        <div class="o_glc_chart_canvas_wrapper">
                            <canvas t-ref="structChart"/>
                        </div>
                    </div>

                    <div class="o_glc_chart_block">
                        <h6 class="o_glc_chart_title">Solde par axe analytique — cumul période</h6>
                        <div class="o_glc_chart_canvas_wrapper o_glc_chart_activity">
                            <canvas t-ref="activityChart"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
