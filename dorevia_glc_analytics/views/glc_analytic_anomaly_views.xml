<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_analytic_anomaly_wizard_form" model="ir.ui.view">
        <field name="name">glc.analytic.anomaly.wizard.form</field>
        <field name="model">glc.analytic.anomaly.wizard</field>
        <field name="arch" type="xml">
            <form string="Audit">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not structure_alert_active">
                        <strong>A6 — Synthèse STRUCTURE</strong>
                        <span class="ms-2">
                            <field name="structure_alert_message" nolabel="1" readonly="1"/>
                            (<field name="structure_weight_pct" nolabel="1" readonly="1"/> %)
                        </span>
                    </div>
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="structure_alert_active or not structure_weight_pct">
                        <strong>A6 — Synthèse STRUCTURE</strong>
                        <span class="ms-2">
                            Poids STRUCTURE :
                            <field name="structure_weight_pct" nolabel="1" readonly="1"/> %
                            (seuil non atteint)
                        </span>
                    </div>
                    <div class="alert alert-secondary mb-3" role="alert"
                         invisible="a5_enabled">
                        <field name="a5_info_message" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="include_posted"/>
                            <field name="include_draft"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Compteurs par contrôle" invisible="not line_count">
                        <field name="count_a1" readonly="1"/>
                        <field name="count_a2" readonly="1"/>
                        <field name="count_a4" readonly="1"/>
                        <field name="count_a5" readonly="1"/>
                    </group>
                    <field name="structure_alert_active" invisible="1"/>
                    <field name="a5_enabled" invisible="1"/>
                    <notebook invisible="not line_ids">
                        <page string="Anomalies détectées">
                            <field name="line_ids" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="date"/>
                                    <field name="anomaly_type"/>
                                    <field name="message"/>
                                    <field name="move_id"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="account_id" optional="hide"/>
                                    <field name="amount" optional="show"/>
                                    <field name="recommendation" optional="hide"/>
                                    <button name="action_open_move" type="object"
                                            string="Ouvrir la pièce" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_analyze" type="object" string="Analyser" class="btn-primary"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_glc_analytic_anomaly_wizard" model="ir.actions.act_window">
        <field name="name">Audit</field>
        <field name="res_model">glc.analytic.anomaly.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
