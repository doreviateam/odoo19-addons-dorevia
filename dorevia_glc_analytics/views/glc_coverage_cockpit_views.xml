<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_coverage_cockpit_form" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.form</field>
        <field name="model">glc.coverage.cockpit</field>
        <field name="arch" type="xml">
            <form string="Cockpit couverture des salaires" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object"
                            string="Actualiser le cockpit" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="display_title" readonly="1" nolabel="1" class="o_text_overflow"/>
                        </h1>
                        <p class="text-muted mb-0">
                            Les recettes d'activité et les financements couvrent-elles les salaires,
                            puis les frais généraux ?
                        </p>
                    </div>

                    <div class="alert alert-secondary mb-3" role="alert"
                         invisible="is_refreshed">
                        <strong>Prêt à analyser</strong>
                        <span class="ms-2">
                            Réglez les filtres ci-dessous, puis cliquez sur
                            <em>Actualiser le cockpit</em>.
                        </span>
                    </div>

                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="alert_status != 'red' or not is_refreshed">
                        <strong>Alerte rouge — soutenabilité critique</strong>
                        <div class="mt-1">
                            <field name="alert_message" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="alert_status != 'orange' or not is_refreshed">
                        <strong>Alerte orange — salaires couverts, frais généraux non</strong>
                        <div class="mt-1">
                            <field name="alert_message" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="alert_status != 'green' or not is_refreshed">
                        <strong>Alerte verte — soutenabilité OK</strong>
                        <div class="mt-1">
                            <field name="alert_message" nolabel="1" readonly="1"/>
                        </div>
                    </div>

                    <group string="Filtres de lecture">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="year"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="activity_account_id"
                                   placeholder="Toutes les activités GLC"/>
                            <field name="budget_scenario"/>
                            <field name="date_from" readonly="1" string="Période du"/>
                            <field name="date_to" readonly="1" string="Période au"/>
                        </group>
                    </group>

                    <field name="currency_id" invisible="1"/>
                    <field name="alert_status" invisible="1"/>
                    <field name="is_refreshed" invisible="1"/>

                    <separator string="Ressources disponibles"/>

                    <group>
                        <group string="Réalisé">
                            <field name="activity_revenue_realized" readonly="1"/>
                            <field name="funding_realized" readonly="1"/>
                            <field name="resources_realized" readonly="1"
                                   class="fw-bold"/>
                        </group>
                        <group string="Budget prévisionnel">
                            <field name="activity_revenue_budget" readonly="1"/>
                            <field name="funding_budget" readonly="1"/>
                            <field name="resources_budget" readonly="1"
                                   class="fw-bold"/>
                        </group>
                    </group>

                    <separator string="Charges et couverture"/>

                    <group>
                        <group string="Réalisé">
                            <field name="payroll_realized" readonly="1"/>
                            <field name="general_expenses_realized" readonly="1"/>
                            <field name="fixed_charges_realized" readonly="1"/>
                        </group>
                        <group string="Budget prévisionnel">
                            <field name="payroll_budget" readonly="1"/>
                            <field name="general_expenses_budget" readonly="1"/>
                            <field name="salary_coverage_rate" readonly="1"/>
                        </group>
                    </group>

                    <group string="Soldes de couverture">
                        <group>
                            <field name="balance_after_payroll" readonly="1"/>
                            <field name="balance_after_fixed" readonly="1"/>
                        </group>
                    </group>

                    <notebook invisible="not line_ids">
                        <page string="Détail Activité × Mois">
                            <p class="text-muted">
                                Lecture croisée par activité GLC et par mois :
                                recettes, masse salariale ventilée (Palier 2) et frais généraux.
                            </p>
                            <field name="line_ids" nolabel="1">
                                <list create="0" delete="0" edit="0"
                                      default_order="period_date, analytic_account_id">
                                    <field name="period_date"/>
                                    <field name="analytic_account_id"/>
                                    <field name="revenue_realized" sum="Total réalisé"/>
                                    <field name="revenue_budget" sum="Total budget"/>
                                    <field name="variance_revenue" sum="Total écart"/>
                                    <field name="payroll_realized" sum="Total réalisé"/>
                                    <field name="payroll_budget" sum="Total budget"/>
                                    <field name="variance_payroll" sum="Total écart"/>
                                    <field name="expense_realized" sum="Total réalisé"
                                           optional="show"/>
                                    <field name="expense_budget" sum="Total budget"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_glc_coverage_cockpit" model="ir.actions.act_window">
        <field name="name">Cockpit couverture des salaires</field>
        <field name="res_model">glc.coverage.cockpit</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

</odoo>
