<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_coverage_cockpit_form" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.form</field>
        <field name="model">glc.coverage.cockpit</field>
        <field name="arch" type="xml">
            <form string="Cockpit couverture des charges de structure" create="0" delete="0"
                  js_class="glc_coverage_cockpit_form">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="alert_status" invisible="1"/>
                    <field name="detail_line_count" invisible="1"/>
                    <field name="activity_account_id" invisible="1"/>
                    <field name="is_refreshed" invisible="1"/>

                    <div class="alert alert-danger mb-3 py-2 d-flex flex-nowrap align-items-baseline gap-2"
                         role="alert"
                         invisible="alert_status != 'red' or not detail_line_count">
                        <strong class="mb-0 text-nowrap">Alerte rouge — masse salariale non couverte</strong>
                        <field name="alert_message" nolabel="1" readonly="1" class="mb-0 o_text_overflow"/>
                    </div>
                    <div class="alert alert-warning mb-3 py-2 d-flex flex-nowrap align-items-baseline gap-2"
                         role="alert"
                         invisible="alert_status != 'orange' or not detail_line_count">
                        <strong class="mb-0 text-nowrap">Alerte orange — charges de structure partiellement couvertes</strong>
                        <field name="alert_message" nolabel="1" readonly="1" class="mb-0 o_text_overflow"/>
                    </div>
                    <div class="alert alert-success mb-3 py-2 d-flex flex-nowrap align-items-baseline gap-2"
                         role="alert"
                         invisible="alert_status != 'green' or not detail_line_count">
                        <strong class="mb-0 text-nowrap">Alerte verte — charges de structure couvertes</strong>
                        <field name="alert_message" nolabel="1" readonly="1" class="mb-0 o_text_overflow"/>
                    </div>

                    <div class="oe_title mb-3">
                        <h1>
                            <field name="display_title" readonly="1" nolabel="1" class="o_text_overflow"/>
                        </h1>
                    </div>

                    <group string="Filtres de lecture">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="budget_scenario" options="{'autosave': true}"/>
                            <field name="period_range_label" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Synthèse graphique" name="page_synthesis">
                            <p class="text-muted mb-1">
                                Lecture immédiate de pilotage :
                                marge d'activité, structure mensuelle et marge par activité.
                            </p>
                            <p class="text-muted small mb-3">
                                Marge d'activité = Recettes − Salaires − Dépenses hors salaires.
                            </p>
                            <div class="alert alert-light border mb-0" role="status"
                                 invisible="detail_line_count">
                                <p class="mb-2">
                                    Aucune donnée détaillée disponible pour cette période
                                    et ces filtres.
                                </p>
                                <p class="mb-0">
                                    Vérifiez la période et le scénario budgétaire pour afficher
                                    la synthèse graphique.
                                </p>
                            </div>
                            <field name="line_ids" nolabel="1" readonly="1"
                                   widget="glc_coverage_synthesis"
                                   invisible="not detail_line_count"/>
                        </page>
                        <page string="Détail par activité" name="page_detail">
                            <p class="text-muted">
                                Par activité et par mois : recettes, salaires, dépenses hors salaires
                                et marge d'activité, comparés au prévu.
                                Sous-totaux mensuels et total période calculés côté client.
                            </p>
                            <field name="detail_line_count" invisible="1"/>
                            <div class="alert alert-light border mb-0" role="status"
                                 invisible="detail_line_count">
                                <p class="mb-2">
                                    Aucune ligne détaillée disponible pour cette période
                                    et ces filtres.
                                </p>
                                <p class="mb-0">
                                    Consultez les onglets Ressources et Charges de structure
                                    pour le résumé de couverture.
                                </p>
                            </div>
                            <field name="line_ids" nolabel="1" readonly="1"
                                   widget="glc_coverage_detail"
                                   invisible="not detail_line_count"/>
                        </page>
                        <page string="Ressources">
                            <p class="text-muted">
                                Ressources disponibles = recettes d'activité + financements.
                            </p>
                            <group>
                                <group string="Réalisé">
                                    <field name="activity_revenue_realized" readonly="1"/>
                                    <field name="funding_realized" readonly="1"/>
                                    <field name="resources_realized" readonly="1"
                                           class="fw-bold"/>
                                </group>
                                <group string="Prévu">
                                    <field name="activity_revenue_budget" readonly="1"/>
                                    <field name="funding_budget" readonly="1"/>
                                    <field name="resources_budget" readonly="1"
                                           class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Charges de structure">
                            <p class="text-muted">
                                Charges de structure = masse salariale + frais généraux.
                                Lecture réalisé vs prévu et solde après charges de structure.
                            </p>
                            <group>
                                <group string="Réalisé">
                                    <field name="payroll_realized" readonly="1"/>
                                    <field name="general_expenses_realized" readonly="1"/>
                                    <field name="fixed_charges_realized" readonly="1"
                                           class="fw-bold"/>
                                </group>
                                <group string="Prévu">
                                    <field name="payroll_budget" readonly="1"/>
                                    <field name="general_expenses_budget" readonly="1"/>
                                    <field name="salary_coverage_rate" readonly="1"/>
                                </group>
                            </group>
                            <group string="Solde de structure">
                                <group>
                                    <field name="balance_after_payroll" readonly="1"/>
                                    <field name="balance_after_fixed" readonly="1"
                                           class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Infos">
                            <p class="text-muted mb-3">
                                Les recettes d'activité et les financements couvrent-elles
                                les charges de structure, dont les salaires ?
                            </p>
                            <p class="text-muted mb-0">
                                Le cockpit se met à jour automatiquement lorsque vous modifiez
                                les filtres de lecture.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_glc_coverage_cockpit_line_search" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.line.search</field>
        <field name="model">glc.coverage.cockpit.line</field>
        <field name="arch" type="xml">
            <search string="Détail cockpit">
                <field name="activity_label"/>
                <field name="month_label"/>
                <field name="analytic_account_id"/>
                <filter string="Activité" name="line_kind_activity"
                        domain="[('line_kind', '=', 'activity')]"/>
                <group>
                    <filter string="Mois" name="group_month"
                            context="{'group_by': 'period_date:month'}"/>
                    <filter string="Activité" name="group_activity"
                            context="{'group_by': 'analytic_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_glc_coverage_cockpit_line_list_grouped" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.line.list.grouped</field>
        <field name="model">glc.coverage.cockpit.line</field>
        <field name="arch" type="xml">
            <list string="Détail par activité" create="0" delete="0" edit="0"
                  expand="1"
                  default_order="month_key, analytic_account_id">
                <field name="line_kind" column_invisible="1"/>
                <field name="cockpit_id" column_invisible="1"/>
                <field name="month_key" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="period_date" string="Mois" optional="hide"/>
                <field name="activity_label" string="Activité"/>
                <field name="revenue_realized" sum="Total recettes réelles"/>
                <field name="revenue_budget" sum="Total recettes budgétées"/>
                <field name="variance_revenue" sum="Total écart recettes"/>
                <field name="payroll_realized" sum="Total masse sal. réelle"/>
                <field name="payroll_budget" sum="Total masse sal. budgétée"/>
                <field name="variance_payroll" sum="Total écart masse sal."/>
                <field name="expense_realized" sum="Total frais gén. réels"/>
                <field name="expense_budget" sum="Total frais gén. budgétés"/>
                <field name="variance_expense" sum="Total écart frais gén."/>
            </list>
        </field>
    </record>

    <delete model="ir.actions.act_window" id="action_glc_coverage_cockpit"/>

    <record id="action_glc_coverage_cockpit" model="ir.actions.server">
        <field name="name">Cockpit couverture des charges de structure</field>
        <field name="model_id" ref="model_glc_coverage_cockpit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_default_cockpit()</field>
    </record>

</odoo>
