<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_coverage_cockpit_form" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.form</field>
        <field name="model">glc.coverage.cockpit</field>
        <field name="arch" type="xml">
            <form string="Cockpit couverture des charges de structure" create="0" delete="0"
                  js_class="glc_coverage_cockpit_form">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="alert_status" invisible="1"/>
                    <field name="detail_line_count" invisible="1"/>
                    <field name="has_budget_data" invisible="1"/>
                    <field name="is_refreshed" invisible="1"/>

                    <div class="alert alert-danger mb-3 py-2 d-flex flex-nowrap align-items-baseline gap-2"
                         role="alert"
                         invisible="alert_status != 'red' or not detail_line_count">
                        <strong class="mb-0 text-nowrap">Alerte rouge — masse salariale non couverte</strong>
                        <field name="alert_message" nolabel="1" readonly="1" class="mb-0 o_text_overflow"/>
                    </div>
                    <div class="alert alert-warning mb-3 py-2 d-flex flex-nowrap align-items-baseline gap-2"
                         role="alert"
                         invisible="alert_status != 'orange' or not detail_line_count">
                        <strong class="mb-0 text-nowrap">Alerte orange — charges de structure partiellement couvertes</strong>
                        <field name="alert_message" nolabel="1" readonly="1" class="mb-0 o_text_overflow"/>
                    </div>
                    <div class="alert alert-success mb-3 py-2 d-flex flex-nowrap align-items-baseline gap-2"
                         role="alert"
                         invisible="alert_status != 'green' or not detail_line_count">
                        <strong class="mb-0 text-nowrap">Alerte verte — charges de structure couvertes</strong>
                        <field name="alert_message" nolabel="1" readonly="1" class="mb-0 o_text_overflow"/>
                    </div>

                    <div class="oe_title mb-3">
                        <h1>
                            <field name="display_title" readonly="1" nolabel="1" class="o_text_overflow"/>
                        </h1>
                    </div>

                    <group string="Filtres de lecture">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="budget_scenario" options="{'autosave': true}"/>
                            <field name="activity_account_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Tous les axes"/>
                            <field name="reference_bank_journal_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="reference_bank_account_id" readonly="1"/>
                            <field name="period_range_label" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Synthèse graphique" name="page_synthesis">
                            <p class="text-muted mb-1">
                                Lecture immédiate de pilotage :
                                solde période, structure mensuelle et solde par axe analytique.
                            </p>
                            <p class="text-muted small mb-3">
                                Solde = Ressource − Cumul RH − Dépense.
                            </p>
                            <p class="text-muted small mb-3" invisible="has_budget_data">
                                Aucun budget renseigné sur cette période — les écarts budget ne sont pas significatifs.
                            </p>
                            <field name="detail_line_count" invisible="1"/>
                            <field name="revenue_eligible_amount" invisible="1"/>
                            <field name="revenue_invoiced_amount" invisible="1"/>
                            <field name="revenue_invoiced_rate" invisible="1"/>
                            <field name="expense_eligible_amount" invisible="1"/>
                            <field name="expense_invoiced_amount" invisible="1"/>
                            <field name="expense_invoiced_rate" invisible="1"/>
                            <div class="alert alert-light border mb-0" role="status"
                                 invisible="detail_line_count">
                                <p class="mb-2">
                                    Aucune donnée détaillée disponible pour cette période
                                    et ces filtres.
                                </p>
                                <p class="mb-0">
                                    Vérifiez la période et le scénario budgétaire pour afficher
                                    la synthèse graphique.
                                </p>
                            </div>
                            <field name="line_ids" nolabel="1" readonly="1"
                                   widget="glc_coverage_synthesis"
                                   invisible="not detail_line_count"/>
                        </page>
                        <page string="Détail par axe analytique" name="page_detail">
                            <p class="text-muted mb-1">
                                Par axe analytique et par mois : ressource, cumul RH, dépense et solde.
                            </p>
                            <p class="text-muted small mb-3">
                                Solde = Ressource − Cumul RH − Dépense.
                                Les virements internes 580 qualifiés analytiquement
                                alimentent la ressource (entrée) ou la dépense (sortie).
                            </p>
                            <p class="text-muted small mb-3">
                                Coche « Payé uniquement » pour n'afficher que les montants
                                effectivement encaissés ou réglés (factures au statut payé,
                                écritures banque ou lettrées banque). Rechargez le cockpit
                                après mise à jour du module pour recalculer ces montants.
                            </p>
                            <p class="text-muted small mb-3" invisible="has_budget_data">
                                Aucun budget renseigné sur cette période — cocher « Budget ? » n'affichera que des tirets.
                            </p>
                            <field name="detail_line_count" invisible="1"/>
                            <field name="revenue_eligible_amount" invisible="1"/>
                            <field name="revenue_invoiced_amount" invisible="1"/>
                            <field name="revenue_invoiced_rate" invisible="1"/>
                            <field name="expense_eligible_amount" invisible="1"/>
                            <field name="expense_invoiced_amount" invisible="1"/>
                            <field name="expense_invoiced_rate" invisible="1"/>
                            <div class="alert alert-light border mb-0" role="status"
                                 invisible="detail_line_count">
                                <p class="mb-2">
                                    Aucune ligne détaillée disponible pour cette période
                                    et ces filtres.
                                </p>
                                <p class="mb-0">
                                    Consultez les onglets Ressources et Charges de structure
                                    pour le résumé de couverture.
                                </p>
                            </div>
                            <field name="line_ids" nolabel="1" readonly="1"
                                   widget="glc_coverage_detail"
                                   invisible="not detail_line_count">
                                <list create="0" delete="0" edit="0">
                                    <field name="line_kind" column_invisible="1"/>
                                    <field name="month_key" column_invisible="1"/>
                                    <field name="month_label" column_invisible="1"/>
                                    <field name="activity_label" column_invisible="1"/>
                                    <field name="analytic_code" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="revenue_realized" column_invisible="1"/>
                                    <field name="revenue_realized_paid" column_invisible="1"/>
                                    <field name="revenue_budget" column_invisible="1"/>
                                    <field name="variance_revenue" column_invisible="1"/>
                                    <field name="payroll_realized" column_invisible="1"/>
                                    <field name="payroll_realized_paid" column_invisible="1"/>
                                    <field name="payroll_budget" column_invisible="1"/>
                                    <field name="variance_payroll" column_invisible="1"/>
                                    <field name="expense_realized" column_invisible="1"/>
                                    <field name="expense_realized_paid" column_invisible="1"/>
                                    <field name="expense_budget" column_invisible="1"/>
                                    <field name="variance_expense" column_invisible="1"/>
                                    <field name="performance_realized" column_invisible="1"/>
                                    <field name="performance_budget" column_invisible="1"/>
                                    <field name="variance_performance" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ressources">
                            <p class="text-muted">
                                Ressources disponibles = recettes d'activité + financements.
                            </p>
                            <group>
                                <group string="Réalisé">
                                    <field name="activity_revenue_realized" readonly="1"/>
                                    <field name="funding_realized" readonly="1"/>
                                    <field name="resources_realized" readonly="1"
                                           class="fw-bold"/>
                                </group>
                                <group string="Prévu">
                                    <field name="activity_revenue_budget" readonly="1"/>
                                    <field name="funding_budget" readonly="1"/>
                                    <field name="resources_budget" readonly="1"
                                           class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Charges de structure">
                            <p class="text-muted">
                                Charges de structure = cumul RH + dépenses hors salaires.
                                Lecture réalisé vs prévu et solde après charges de structure.
                            </p>
                            <group>
                                <group string="Réalisé">
                                    <field name="payroll_realized" readonly="1"/>
                                    <field name="general_expenses_realized" readonly="1"/>
                                    <field name="fixed_charges_realized" readonly="1"
                                           class="fw-bold"/>
                                </group>
                                <group string="Prévu">
                                    <field name="payroll_budget" readonly="1"/>
                                    <field name="general_expenses_budget" readonly="1"/>
                                    <field name="salary_coverage_rate" readonly="1"/>
                                </group>
                            </group>
                            <group string="Solde de structure">
                                <group>
                                    <field name="balance_after_payroll" readonly="1"/>
                                    <field name="balance_after_fixed" readonly="1"
                                           class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Trésorerie" name="page_treasury">
                            <p class="text-muted mb-1">
                                Lecture trésorerie depuis le compte bancaire de référence
                                (point de vue distinct de l'exploitation).
                            </p>
                            <p class="text-muted small mb-3">
                                Les KPI Ressource · Cumul RH · Dépense · Solde ne dépendent
                                pas du compte bancaire sélectionné.
                            </p>
                            <p class="text-muted small mb-3" invisible="treasury_has_data">
                                Aucun mouvement trésorerie sur le compte de référence
                                pour cette période.
                            </p>
                            <group string="Flux période" invisible="not treasury_has_data">
                                <group>
                                    <field name="treasury_inflow" readonly="1"/>
                                    <field name="treasury_internal_inflow" readonly="1"/>
                                </group>
                                <group>
                                    <field name="treasury_outflow" readonly="1"/>
                                    <field name="treasury_internal_outflow" readonly="1"/>
                                </group>
                            </group>
                            <group string="Solde trésorerie" invisible="not treasury_has_data">
                                <field name="treasury_net" readonly="1" class="fw-bold"/>
                            </group>
                            <group string="Virements internes par axe analytique"
                                   invisible="not treasury_line_ids">
                                <field name="treasury_line_ids" nolabel="1" readonly="1"
                                       colspan="2">
                                    <list create="0" delete="0" edit="0"
                                          default_order="activity_label">
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="analytic_code" string="Code"/>
                                        <field name="activity_label" string="Axe analytique"/>
                                        <field name="transfer_gl_account_code"
                                               string="Compte comptable"/>
                                        <field name="internal_inflow"
                                               sum="Total entrées internes"/>
                                        <field name="internal_outflow"
                                               sum="Total sorties internes"/>
                                    </list>
                                </field>
                            </group>
                            <field name="treasury_has_data" invisible="1"/>
                        </page>
                        <page string="Contrôles qualité" name="page_quality">
                            <p class="text-muted mb-1">
                                Fiabilité des données comptables et analytiques sur la période.
                            </p>
                            <p class="text-muted small mb-3">
                                Ces indicateurs mesurent la fiabilité des données et le cycle de
                                paiement. Ils ne modifient pas Ressource · Cumul RH · Dépense · Solde.
                            </p>
                            <group string="Q1 — Confiance analytique">
                                <group>
                                    <field name="quality_analytic_confidence_rate" readonly="1"/>
                                    <field name="quality_analytic_confidence_status" readonly="1"
                                           widget="badge"
                                           decoration-success="quality_analytic_confidence_status == 'green'"
                                           decoration-warning="quality_analytic_confidence_status == 'orange'"
                                           decoration-danger="quality_analytic_confidence_status == 'red'"/>
                                    <field name="quality_analytic_confidence_detail" readonly="1" nolabel="1" class="text-muted text-nowrap"/>
                                </group>
                                <group>
                                    <field name="quality_analytic_lines_checked" readonly="1"/>
                                    <field name="quality_analytic_lines_covered" readonly="1"/>
                                    <field name="quality_analytic_lines_to_qualify" readonly="1"/>
                                </group>
                            </group>
                            <div class="mb-3">
                                <button name="action_open_quality_lines_to_qualify"
                                        type="object"
                                        string="Lignes à qualifier"
                                        class="btn-link"/>
                                <button name="action_open_quality_moves_to_qualify"
                                        type="object"
                                        string="Écritures concernées"
                                        class="btn-link ms-2"/>
                            </div>
                            <group string="Q2 — Lettrage tiers (stock à fin période)">
                                <group string="Clients (411)">
                                    <field name="quality_reconcile_rate_customer" readonly="1"/>
                                    <field name="quality_unreconciled_amount_customer" readonly="1"/>
                                    <field name="quality_unreconciled_count_customer" readonly="1"/>
                                    <button name="action_open_unreconciled_customer_lines"
                                            type="object"
                                            string="Lignes clients non lettrées"
                                            class="btn-link"/>
                                </group>
                                <group string="Fournisseurs (401)">
                                    <field name="quality_reconcile_rate_supplier" readonly="1"/>
                                    <field name="quality_unreconciled_amount_supplier" readonly="1"/>
                                    <field name="quality_unreconciled_count_supplier" readonly="1"/>
                                    <button name="action_open_unreconciled_supplier_lines"
                                            type="object"
                                            string="Lignes fournisseurs non lettrées"
                                            class="btn-link"/>
                                </group>
                            </group>
                            <group string="Ancienneté créances / dettes ouvertes">
                                <group string="Clients">
                                    <field name="quality_aging_customer_0_30" readonly="1"/>
                                    <field name="quality_aging_customer_31_60" readonly="1"/>
                                    <field name="quality_aging_customer_61_90" readonly="1"/>
                                    <field name="quality_aging_customer_90_plus" readonly="1"/>
                                </group>
                                <group string="Fournisseurs">
                                    <field name="quality_aging_supplier_0_30" readonly="1"/>
                                    <field name="quality_aging_supplier_31_60" readonly="1"/>
                                    <field name="quality_aging_supplier_61_90" readonly="1"/>
                                    <field name="quality_aging_supplier_90_plus" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tiers &amp; paiements" name="page_payment">
                            <p class="text-muted mb-1">
                                Cycle de facturation et règlement sur la période (pièces postées).
                            </p>
                            <p class="text-muted small mb-3">
                                Ces indicateurs mesurent la fiabilité des données et le cycle de
                                paiement. Ils ne modifient pas Ressource · Cumul RH · Dépense · Solde.
                            </p>
                            <group string="Q3 — Clients">
                                <group>
                                    <field name="payment_customer_invoice_count" readonly="1"/>
                                    <field name="payment_customer_invoice_amount" readonly="1"/>
                                    <field name="payment_customer_paid_count" readonly="1"/>
                                    <field name="payment_customer_paid_amount" readonly="1"/>
                                    <field name="payment_customer_partial_count" readonly="1"/>
                                    <field name="payment_customer_partial_amount" readonly="1"/>
                                </group>
                                <group>
                                    <field name="payment_customer_in_payment_count" readonly="1"/>
                                    <field name="payment_customer_in_payment_amount" readonly="1"/>
                                    <field name="payment_customer_not_paid_count" readonly="1"/>
                                    <field name="payment_customer_not_paid_amount" readonly="1"/>
                                    <field name="payment_customer_refund_count" readonly="1"/>
                                    <field name="payment_customer_refund_amount" readonly="1"/>
                                    <field name="payment_customer_residual" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                            <div class="mb-3">
                                <button name="action_open_payment_customer_invoices"
                                        type="object"
                                        string="Factures clients période"
                                        class="btn-link"/>
                                <button name="action_open_payment_customer_open"
                                        type="object"
                                        string="Factures clients ouvertes"
                                        class="btn-link ms-2"/>
                            </div>
                            <group string="Q3 — Fournisseurs">
                                <group>
                                    <field name="payment_supplier_invoice_count" readonly="1"/>
                                    <field name="payment_supplier_invoice_amount" readonly="1"/>
                                    <field name="payment_supplier_paid_count" readonly="1"/>
                                    <field name="payment_supplier_paid_amount" readonly="1"/>
                                    <field name="payment_supplier_partial_count" readonly="1"/>
                                    <field name="payment_supplier_partial_amount" readonly="1"/>
                                </group>
                                <group>
                                    <field name="payment_supplier_in_payment_count" readonly="1"/>
                                    <field name="payment_supplier_in_payment_amount" readonly="1"/>
                                    <field name="payment_supplier_not_paid_count" readonly="1"/>
                                    <field name="payment_supplier_not_paid_amount" readonly="1"/>
                                    <field name="payment_supplier_refund_count" readonly="1"/>
                                    <field name="payment_supplier_refund_amount" readonly="1"/>
                                    <field name="payment_supplier_residual" readonly="1" class="fw-bold"/>
                                </group>
                            </group>
                            <div class="mb-3">
                                <button name="action_open_payment_supplier_invoices"
                                        type="object"
                                        string="Factures fournisseurs période"
                                        class="btn-link"/>
                                <button name="action_open_payment_supplier_open"
                                        type="object"
                                        string="Factures fournisseurs ouvertes"
                                        class="btn-link ms-2"/>
                            </div>
                        </page>
                        <page string="Infos">
                            <p class="text-muted mb-3">
                                Les recettes d'activité et les financements couvrent-elles
                                les charges de structure, dont le cumul RH ?
                            </p>
                            <group string="Contrôle RH (informatif)">
                                <group>
                                    <field name="payroll_realized" readonly="1"
                                           string="Paie comptable (cumul RH réalisé)"/>
                                    <field name="salary_allocation_total" readonly="1"/>
                                    <field name="payroll_reconciliation_gap" readonly="1"/>
                                </group>
                                <group>
                                    <field name="payroll_reconciliation_status" readonly="1"
                                           widget="badge"
                                           decoration-success="payroll_reconciliation_status == 'ok'"
                                           decoration-warning="payroll_reconciliation_status == 'check'"
                                           decoration-muted="payroll_reconciliation_status == 'na'"/>
                                </group>
                            </group>
                            <p class="text-muted mb-0">
                                Le réalisé cockpit provient de la comptabilité analytique.
                                Les ventilations Palier 2 servent au contrôle de cohérence.
                            </p>
                            <p class="text-muted mb-0 mt-2">
                                Le cockpit se met à jour automatiquement lorsque vous modifiez
                                les filtres de lecture.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_glc_coverage_cockpit_line_search" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.line.search</field>
        <field name="model">glc.coverage.cockpit.line</field>
        <field name="arch" type="xml">
            <search string="Détail cockpit">
                <field name="activity_label"/>
                <field name="month_label"/>
                <field name="analytic_account_id"/>
                <filter string="Activité" name="line_kind_activity"
                        domain="[('line_kind', '=', 'activity')]"/>
                <group>
                    <filter string="Mois" name="group_month"
                            context="{'group_by': 'period_date:month'}"/>
                    <filter string="Activité" name="group_activity"
                            context="{'group_by': 'analytic_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_glc_coverage_cockpit_line_list_grouped" model="ir.ui.view">
        <field name="name">glc.coverage.cockpit.line.list.grouped</field>
        <field name="model">glc.coverage.cockpit.line</field>
        <field name="arch" type="xml">
            <list string="Détail par activité" create="0" delete="0" edit="0"
                  expand="1"
                  default_order="month_key, analytic_account_id">
                <field name="line_kind" column_invisible="1"/>
                <field name="cockpit_id" column_invisible="1"/>
                <field name="month_key" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="period_date" string="Mois" optional="hide"/>
                <field name="activity_label" string="Activité"/>
                <field name="revenue_realized" sum="Total ressources réelles"/>
                <field name="revenue_budget" sum="Total ressources budgétées"/>
                <field name="variance_revenue" sum="Total écart ressources"/>
                <field name="payroll_realized" sum="Total masse sal. réelle"/>
                <field name="payroll_budget" sum="Total masse sal. budgétée"/>
                <field name="variance_payroll" sum="Total écart masse sal."/>
                <field name="expense_realized" sum="Total dépenses réelles"/>
                <field name="expense_budget" sum="Total dépenses budgétées"/>
                <field name="variance_expense" sum="Total écart dépenses"/>
            </list>
        </field>
    </record>

    <delete model="ir.actions.act_window" id="action_glc_coverage_cockpit"/>

    <record id="action_glc_coverage_cockpit" model="ir.actions.server">
        <field name="name">Cockpit couverture des charges de structure</field>
        <field name="model_id" ref="model_glc_coverage_cockpit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_default_cockpit()</field>
    </record>

</odoo>
