<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_analytic_account_form_glc" model="ir.ui.view">
        <field name="name">account.analytic.account.form.glc</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pilotage GLC" groups="dorevia_glc_analytics.group_glc_user">
                    <group>
                        <group>
                            <field name="glc_activity_type"/>
                            <field name="glc_display_sequence"/>
                            <field name="glc_report_active"/>
                        </group>
                        <group>
                            <field name="glc_pilotage_comment" placeholder="Commentaire de gestion pour le CA…"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_list_glc" model="ir.ui.view">
        <field name="name">account.analytic.account.list.glc</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='code']" position="after">
                <field name="glc_activity_type" optional="show"/>
                <field name="glc_display_sequence" optional="hide"/>
                <field name="glc_report_active" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_glc_analytic_accounts_activites" model="ir.actions.act_window">
        <field name="name">Comptes analytiques GLC</field>
        <field name="res_model">account.analytic.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('plan_id', '=', ref('dorevia_glc_analytics.analytic_plan_glc_activites'))]"/>
        <field name="context" eval="{
            'default_plan_id': ref('dorevia_glc_analytics.analytic_plan_glc_activites'),
            'search_default_active': 1,
        }"/>
    </record>

</odoo>
