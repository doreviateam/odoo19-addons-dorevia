<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_membership_roles" model="ir.ui.view">
        <field name="name">res.partner.form.membership.roles</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="membership.view_partner_form"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <field name="free_member" position="after">
                <field
                    name="membership_role_ids"
                    widget="many2many_tags"
                    context="{'active_test': False}"
                    domain="[('active', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                />
            </field>
        </field>
    </record>
</odoo>
