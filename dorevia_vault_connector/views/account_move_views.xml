<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_dorevia_vault" model="ir.ui.view">
        <field name="name">account.move.form.dorevia_vault_connector</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Onglet « Dorevia Vault » juste avant « Autres informations » (page id=other_tab). -->
            <xpath expr="//page[@id='other_tab']" position="before">
                <page
                    string="Dorevia Vault"
                    name="dorevia_vault_tab"
                    invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"
                >
                    <group>
                        <group>
                            <field name="dorevia_vault_status"/>
                            <field name="dorevia_vault_last_attempt_at"/>
                            <field name="dorevia_vault_remote_ref"/>
                        </group>
                        <group>
                            <field name="dorevia_vault_error_message" colspan="2"/>
                        </group>
                    </group>
                    <group>
                        <button
                            name="action_retry_dorevia_vault_send"
                            type="object"
                            string="Réessayer l'envoi Vault"
                            class="btn-secondary"
                            invisible="state != 'posted' or dorevia_vault_status not in ('failed', 'todo')"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
