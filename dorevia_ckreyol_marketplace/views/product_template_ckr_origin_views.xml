<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Miroir des lignes d’attribut « Origine » dans l’onglet Ventes,
         groupe « Boutique e-commerce » (SPEC_IMPL — confort éditeur). -->
    <record id="product_template_form_view_ckr_origin" model="ir.ui.view">
        <field name="name">product.template.form.ckr.origin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="public_categ_ids" position="after">
                <field name="ckr_origin_value_ids"
                       widget="many2many_tags"
                       string="Origines"
                       domain="[('attribute_id', '=', %(dorevia_ckreyol_marketplace.ckr_product_attribute_origin)d)]"
                       context="{'default_attribute_id': %(dorevia_ckreyol_marketplace.ckr_product_attribute_origin)d}"
                       options="{'no_create_edit': True, 'color_field': 'color'}"
                       invisible="not sale_ok"
                       placeholder="Sélectionnez une ou plusieurs origines…"/>
            </field>
        </field>
    </record>

</odoo>
