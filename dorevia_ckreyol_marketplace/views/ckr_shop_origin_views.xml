<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Profils origine CK (`ckr.shop.origin`)                      -->
    <!-- SPEC_IMPL_ORIGINES.md §2.3                                 -->
    <!--                                                            -->
    <!-- * Site web > Configuration > C-Kreyol > Origines           -->
    <!--   (parent `website.menu_website_global_configuration` —    -->
    <!--   menu « Configuration » Odoo, reserve administrateurs)   -->
    <!--                                                            -->
    <!-- * Site web > eCommerce > Produits > C-Kreyol > Origines    -->
    <!--   (meme confort que les categories : `website_sale.         -->
    <!--   menu_catalog` + groupe `website.group_website_designer`) -->
    <!-- ========================================================== -->

    <record id="view_ckr_shop_origin_search" model="ir.ui.view">
        <field name="name">ckr.shop.origin.search</field>
        <field name="model">ckr.shop.origin</field>
        <field name="arch" type="xml">
            <search string="Origines C-Kreyol">
                <field name="slug"/>
                <field name="name_visitor"/>
                <field name="attribute_value_id"/>
                <filter name="filter_published" string="Publiés" domain="[('website_published', '=', True)]"/>
                <filter name="filter_unpublished" string="Non publiés" domain="[('website_published', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_ckr_shop_origin_tree" model="ir.ui.view">
        <field name="name">ckr.shop.origin.list</field>
        <field name="model">ckr.shop.origin</field>
        <field name="arch" type="xml">
            <list string="Origines C-Kreyol" default_order="sequence, slug">
                <field name="sequence" widget="handle"/>
                <field name="slug"/>
                <field name="display_name_visitor"/>
                <field name="attribute_value_id"/>
                <field name="website_id" optional="hide"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="view_ckr_shop_origin_form" model="ir.ui.view">
        <field name="name">ckr.shop.origin.form</field>
        <field name="model">ckr.shop.origin</field>
        <field name="arch" type="xml">
            <form string="Profil origine">
                <sheet>
                    <group>
                        <group string="Lien catalogue">
                            <field name="attribute_value_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Publication">
                            <field name="website_published"/>
                            <field name="website_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Lecture visiteur">
                        <field name="slug" placeholder="ex. martinique"/>
                        <field name="name_visitor" placeholder="Libellé affiché (sinon nom de la valeur)"/>
                        <field name="context_phrase" placeholder="Phrase courte sous le bandeau (une origine)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ckr_shop_origin" model="ir.actions.act_window">
        <field name="name">Origines</field>
        <field name="res_model">ckr.shop.origin</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ckr_shop_origin_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez un profil par valeur d’attribut catalogue « Origine »
                (slug URL, nom visiteur, phrase de contexte, publication).
            </p>
            <p>
                La provenance des produits reste portée par les attributs
                produits ; ce modèle ne fait que décorer et router la porte
                <code>/shop?ckr_mode=origin</code>.
            </p>
        </field>
    </record>

    <!-- Branche Configuration (meme visibilite que le menu parent Odoo) -->
    <menuitem id="menu_ckreyol_configuration_root"
              name="C-Kreyol"
              parent="website.menu_website_global_configuration"
              sequence="46"/>
    <menuitem id="menu_ckreyol_configuration_origins"
              name="Origines"
              parent="menu_ckreyol_configuration_root"
              action="action_ckr_shop_origin"
              sequence="10"/>

    <!-- Branche eCommerce > Produits (concepteurs de site) -->
    <menuitem id="menu_ckreyol_catalog_root"
              name="C-Kreyol"
              parent="website_sale.menu_catalog"
              sequence="7"
              groups="website.group_website_designer"/>
    <menuitem id="menu_ckreyol_catalog_origins"
              name="Origines"
              parent="menu_ckreyol_catalog_root"
              action="action_ckr_shop_origin"
              sequence="10"
              groups="website.group_website_designer"/>

</odoo>
