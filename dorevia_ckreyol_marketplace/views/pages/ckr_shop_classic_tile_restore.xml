<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================== -->
    <!-- Theme Classic Store remplace `o_wsale_product_information` par une     -->
    <!-- colonne sans `o_wsale_product_sub` (prix dans le texte, panier dans     -->
    <!-- `o_quick_add_btn`). Les surcharges CK (filet, ligne prix+panier) ne    -->
    <!-- matchent plus le DOM — d’où wishlist / séparateur / alignement cassés. -->
    <!-- Ici : structure officielle `website_sale.products_item` + rail coin     -->
    <!-- média (`ckr_shop_wishlist_on_product_media` : wishlist `o_add_wishlist` +   -->
    <!-- bouton info `fa-info`, panneau `ckr-product-card__details-body`) + micro-cat. -->
    <!-- Quick-add thème : masqué en SCSS                                          -->
    <!-- (`.ckr-shop … .o_quick_add_btn`) — pas d’xpath QWeb : le nœud peut     -->
    <!-- être absent (autre thème / arch Odoo) → ParseError à la mise à jour.   -->
    <!-- ====================================================================== -->

    <!-- Coin média : rail `ckr-product-card__corner-actions` (wishlist + info).    -->
    <!-- Le bloc info n’est pas un ancêtre fiable pour `position:absolute` (thème). -->
    <template id="ckr_shop_wishlist_on_product_media"
              inherit_id="website_sale.products_item"
              name="C-Kreyol: coin média — wishlist + info (oe_product_image)"
              priority="69">
        <!-- `oe_product_image` : souvent `t-attf-class` (Odoo 19), parfois `class` seul selon surcharges. -->
        <xpath expr="//form[contains(@t-attf-class, 'oe_product_cart') or hasclass('oe_product_cart')]//div[hasclass('oe_product_image') or contains(@t-attf-class, 'oe_product_image')]"
               position="inside">
            <t t-set="is_wishlist_page"
               t-value="request and request.httprequest.path == '/shop/wishlist'"/>
            <t t-set="ckr_tile_website" t-value="website or (request and request.website)"/>
            <t t-set="ckr_tile_meta" t-value="product._ckr_get_shop_tile_meta_line(ckr_tile_website)"/>
            <t t-set="combination_name" t-value=""/>
            <t t-if="product_variant">
                <t t-set="combination_name" t-value="product_variant.product_template_attribute_value_ids._get_combination_name()"/>
            </t>
            <t t-set="ckr_tile_desc_line" t-value="product._ckr_get_shop_tile_description_line()"/>
            <t t-set="ckr_tile_sub_line" t-value="product._ckr_get_shop_tile_subtitle(ckr_tile_website)"/>
            <t t-set="ckr_tile_info_third" t-value="ckr_tile_desc_line or ckr_tile_sub_line"/>
            <t t-set="ckr_show_more" t-value="product._ckr_shop_tile_has_more_block(ckr_tile_website)"/>
            <t t-set="product_variant_id"
               t-value="product._get_first_possible_variant_id() or (product.product_variant_ids[0].id if product.product_variant_ids else False)"/>
            <!-- Coin média : sur grille /shop, rail wishlist + bouton info (`fa-info`) ; sur `/shop/wishlist`, non rendu (`not is_wishlist_page`). -->
            <t t-if="not is_wishlist_page">
                <div class="ckr-product-card__media-corner">
                    <div class="o_wsale_product_btn wishlist-above-title ckr-product-card__corner-actions"
                         style="position:relative !important;inset:auto !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;flex-direction:row !important;flex-wrap:nowrap !important;gap:0.12rem !important;width:4.05rem !important;min-width:4.05rem !important;height:1.9rem !important;min-height:1.9rem !important;padding:0.14rem 0.2rem !important;margin:0 !important;border:0 !important;border-radius:0.58rem !important;background:rgba(255,253,250,0.22) !important;background-color:rgba(255,253,250,0.22) !important;background-image:none !important;box-shadow:0 2px 10px rgba(44,38,30,0.06) !important;backdrop-filter:blur(6px) saturate(1.04) !important;-webkit-backdrop-filter:blur(6px) saturate(1.04) !important;overflow:visible !important;">
                        <t t-set="in_wish"
                           t-value="product in (products_in_wishlist or [])"/>
                        <t t-set="ckr_wishlist_fg"
                           t-value="'rgba(160, 82, 45, 0.94)' if in_wish else 'rgba(55, 38, 24, 0.68)'"/>
                        <button t-if="product_variant_id"
                                type="button"
                                t-attf-class="btn o_add_wishlist ckr-wishlist-ghost #{'btn-danger o_in_wishlist' if in_wish else 'btn-light'}"
                                t-attf-style="position:relative !important;inset:auto !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;order:1 !important;flex:0 0 1.58rem !important;width:1.58rem !important;min-width:1.58rem !important;max-width:1.58rem !important;height:1.58rem !important;min-height:1.58rem !important;max-height:1.58rem !important;padding:0 !important;margin:0 !important;border:none !important;border-color:transparent !important;border-radius:0.42rem !important;box-shadow:none !important;outline:none !important;outline-offset:0 !important;background:transparent !important;background-color:transparent !important;background-image:none !important;color:#{ckr_wishlist_fg} !important;line-height:1 !important;font-size:0 !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;"
                                data-action="o_wishlist"
                                t-att-data-product-template-id="product.id"
                                t-att-data-product-product-id="product_variant_id"
                                t-att-title="'Retirer de la liste' if in_wish else 'Ajouter à la liste'"
                                aria-label="Liste de souhaits">
                            <i class="fa fa-heart"
                               aria-hidden="true"
                               t-attf-style="display:inline-flex !important;align-items:center !important;justify-content:center !important;font-family:FontAwesome !important;font-size:0.76rem !important;font-weight:normal !important;line-height:1 !important;color:#{ckr_wishlist_fg} !important;opacity:1 !important;visibility:visible !important;filter:drop-shadow(0 0 1px rgba(255,255,255,0.42)) drop-shadow(0 1px 1px rgba(44,38,30,0.08)) !important;"/>
                            </button>
                            <button type="button"
                                    class="ckr-product-card__info-action"
                                    style="position:relative !important;inset:auto !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;order:2 !important;flex:0 0 1.58rem !important;width:1.58rem !important;min-width:1.58rem !important;max-width:1.58rem !important;height:1.58rem !important;min-height:1.58rem !important;max-height:1.58rem !important;padding:0 !important;margin:0 !important;border:0 !important;border-radius:0.42rem !important;box-shadow:none !important;outline:none !important;outline-offset:0 !important;background:transparent !important;background-color:transparent !important;background-image:none !important;color:rgba(55,38,24,0.72) !important;line-height:1 !important;font-size:0 !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;"
                                    title="Informations complémentaires"
                                    aria-label="Informations complémentaires sur ce produit"
                                    aria-haspopup="true">
                            <i class="fa fa-info ckr-product-card__info-icon"
                               aria-hidden="true"
                               style="display:inline-flex !important;align-items:center !important;justify-content:center !important;font-family:FontAwesome !important;font-size:0.76rem !important;font-weight:normal !important;line-height:1 !important;color:inherit !important;opacity:1 !important;visibility:visible !important;filter:drop-shadow(0 0 1px rgba(255,255,255,0.50)) drop-shadow(0 1px 1px rgba(44,38,30,0.10)) !important;"/>
                        </button>
                        <div class="ckr-product-card__details-body"
                             role="tooltip"
                             style="display:none;">
                            <p t-if="ckr_tile_meta"
                               class="ckr-product-card__details-meta text-break mb-1"
                               t-out="ckr_tile_meta"/>
                            <p class="ckr-product-card__details-odoo-name text-break mb-1">
                                <span t-out="product.name"/>
                                <span t-if="combination_name" t-out="' ('+combination_name+')'"/>
                            </p>
                            <p t-if="ckr_tile_info_third"
                               class="ckr-product-card__details-desc text-break mb-0 text-muted small"
                               t-out="ckr_tile_info_third"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="ckr_shop_restore_standard_product_information"
              inherit_id="website_sale.products_item"
              name="C-Kreyol: tuile /shop — structure Odoo standard (remplace layout thème)"
              priority="68">
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="replace">
            <div class="o_wsale_product_information flex-grow-1 flex-shrink-1 ckr-product-card__info">
                <t t-set="ckr_display_name" t-value="(product.ck_product_name or '').strip() or product.name"/>
                <t t-set="combination_name" t-value=""/>
                <t t-if="product_variant">
                    <t t-set="combination_name" t-value="product_variant.product_template_attribute_value_ids._get_combination_name()"/>
                </t>
                <div class="o_wsale_product_info_attributes_wrapper">
                    <t t-if="product_ptavs_data" t-call="website_sale.product_variant_preview"/>
                    <div class="o_wsale_product_information_text flex-grow-1 ckr-product-card__text-stack">
                        <!-- Bloc titre seul dans le flux principal (maquette retail : 2 lignes + filet). -->
                        <div class="ckr-product-card__head">
                            <!-- Inline + !important : dernier recours si le thème écrase le SCSS / le bloc page. -->
                            <h2 class="o_wsale_products_item_title text-break"
                                style="font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important; font-weight: 500 !important; font-size: clamp(0.84rem, 0.2vw + 0.77rem, 0.93rem) !important; line-height: 1.22 !important; letter-spacing: 0.015em !important; color: rgba(0,0,0,0.74) !important; display: block !important; min-height: calc(2 * 1.22 * 1em) !important; height: calc(2 * 1.22 * 1em) !important; max-height: calc(2 * 1.22 * 1em) !important; overflow: hidden !important; margin: 0 !important; border: none !important; font-style: normal !important; -webkit-font-smoothing: antialiased !important;">
                                <a class="text-decoration-none ckr-product-card__name-link"
                                   style="color: inherit !important; font-family: inherit !important; font-weight: inherit !important; font-size: inherit !important; line-height: inherit !important; letter-spacing: inherit !important; text-decoration: none !important; display: -webkit-box !important; -webkit-box-orient: vertical !important; -webkit-line-clamp: 2 !important; overflow: hidden !important; word-break: break-word !important; max-height: 100% !important;"
                                   itemprop="name"
                                   t-att-href="product_href"
                                   t-att-content="ckr_display_name">
                                    <span t-out="ckr_display_name"/>
                                    <span t-if="combination_name" t-out="' ('+combination_name+')'"/>
                                </a>
                                <a t-if="not product.website_published"
                                   role="button"
                                   t-att-href="product_href"
                                   class="btn btn-sm btn-danger"
                                   title="Produit non publié.">
                                    Non publié
                                </a>
                            </h2>
                        </div>
                        <t t-if="is_view_active('website_sale.product_comment')"
                           t-call="website_sale.product_tile_element_visibility">
                            <t t-set="visible_element_class" t-value="'o_wsale_products_opt_has_rating'"/>
                            <div class="o_wsale_product_rating_wrapper">
                                <t t-call="portal_rating.rating_widget_stars_static">
                                    <t t-set="rating_avg" t-value="product.sudo().rating_avg"/>
                                    <t t-set="rating_count" t-value="product.rating_count"/>
                                </t>
                            </div>
                        </t>
                        <t t-if="product_extra_information" t-out="product_extra_information"/>
                    </div>
                </div>
                <!-- Pied : prix | CTA — infos secondaires = panneau sous `fa-info` (gabarit `ckr_shop_wishlist_on_product_media`), pas ici. -->
                <div class="o_wsale_product_sub ckr-product-card__footer">
                    <div class="ckr-product-card__footer-row"
                         style="display:grid !important;grid-template-columns:minmax(0,1fr) max-content !important;align-items:center !important;column-gap:0.45rem;width:100%;">
                        <div class="ckr-product-card__footer-price"
                             style="display:flex;flex:1 1 auto;align-items:center;justify-content:flex-start;min-width:0;margin-left:0;text-align:left;">
                            <t t-if="product_price" t-out="product_price"/>
                            <t t-else="">
                                <t t-set="template_price_vals" t-value="get_product_prices(product)"/>
                                <div class="product_price" aria-label="Price information">
                                    <span class="mb-0 fw-bold"
                                          aria-label="Sale price"
                                          t-if="template_price_vals['price_reduce'] or not website.prevent_zero_price_sale"
                                          t-out="template_price_vals['price_reduce']"
                                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                    <t t-if="'base_price' in template_price_vals and (template_price_vals['base_price'] &gt; template_price_vals['price_reduce']) and (template_price_vals['price_reduce'] or not website.prevent_zero_price_sale)"
                                       name="product_base_price">
                                        <del aria-label="Original price"
                                             t-attf-class="text-muted me-1 mb-0"
                                             style="white-space: nowrap;">
                                            <small t-esc="template_price_vals['base_price']"
                                                   t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                        </del>
                                    </t>
                                </div>
                            </t>
                        </div>
                        <div class="ckr-product-card__footer-cta"
                             style="display:flex;align-items:center;justify-content:flex-end;min-width:0;">
                            <div class="o_wsale_product_btn"
                                 style="display:flex;align-items:center;justify-content:flex-end;min-width:0;">
                                <t t-if="product_actions" t-out="product_actions"/>
                                <t t-else="" t-call="website_sale.shop_product_buttons"/>
                            </div>
                        </div>
                    </div>
                </div>
                <t t-if="extra_actions" t-out="extra_actions"/>
            </div>
        </xpath>
    </template>

</odoo>
