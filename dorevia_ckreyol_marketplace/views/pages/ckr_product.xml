<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Fiche produit e-commerce : scope charte C-Kreyol           -->
    <!--                                                            -->
    <!-- V1 : aucune restructuration du template natif              -->
    <!-- `website_sale.product`. On ajoute uniquement des classes   -->
    <!-- sur `#wrap` pour appliquer le SCSS `layout/_product.scss` -->
    <!-- (typo, couleurs, CTA, variantes, galerie, etc.).          -->
    <!--                                                            -->
    <!-- Prerequis test : un produit publie dans Odoo (pas de data  -->
    <!-- demo injectee par le module).                              -->
    <!-- ========================================================== -->

    <template id="ckr_product_page_scope"
              inherit_id="website_sale.product"
              name="C-Kreyol: fiche produit (scope charte)"
              priority="30">
        <xpath expr="//div[@id='wrap'][hasclass('o_wsale_product_page')]" position="attributes">
            <attribute name="class" add="ckr-product ckr-root ckr-page" separator=" "/>
        </xpath>
    </template>

    <!-- ========================================================== -->
    <!-- Fiche produit : bloc « Origines » + promesse courte         -->
    <!--                                                            -->
    <!-- MVP2.3 : origine non interactive sur la fiche produit.      -->
    <!-- Les libelles d'origine restent informatifs (pas de lien),   -->
    <!-- afin d'eviter toute confusion avec une option selectionnable. -->
    <!--                                                            -->
    <!-- Promesse courte : issue de description_sale via helper      -->
    <!-- `_ckr_get_product_promise_line()`. Si aucune source propre  -->
    <!-- n'est disponible, le bloc n'est pas rendu.                  -->
    <!-- ========================================================== -->

    <template id="ckr_product_origins_block"
              inherit_id="website_sale.product_title"
              name="C-Kreyol: fiche produit - bloc Origines"
              priority="31">
        <xpath expr="//h1" position="before">
            <t t-set="ckr_product_tmpl"
               t-value="product.product_tmpl_id if product._name == 'product.product' else product"/>
            <t t-set="ckr_origin_labels"
               t-value="ckr_product_tmpl._ckr_get_product_origin_labels(website=website)"/>
            <section t-if="ckr_origin_labels"
                     class="ckr-product-origins"
                     aria-label="Origines du produit">
                <span class="ckr-product-origins__label">Origines :</span>
                <ul class="ckr-product-origins__list">
                    <li t-foreach="ckr_origin_labels"
                        t-as="ckr_origin_label"
                        class="ckr-product-origins__item">
                        <span class="ckr-product-origins__value"
                              t-esc="ckr_origin_label"/>
                    </li>
                </ul>
            </section>
        </xpath>
        <xpath expr="//h1" position="after">
            <t t-set="ckr_product_tmpl_promise"
               t-value="product.product_tmpl_id if product._name == 'product.product' else product"/>
            <t t-set="ckr_promise_line"
               t-value="ckr_product_tmpl_promise._ckr_get_product_promise_line()"/>
            <p t-if="ckr_promise_line" class="ckr-product-promise" t-esc="ckr_promise_line"/>
        </xpath>
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="attributes">
            <attribute name="class" add="d-none ckr-product-desc-inline-hidden" separator=" "/>
        </xpath>
    </template>

    <!-- ========================================================== -->
    <!-- Fiche produit : bloc « Collections »                        -->
    <!--                                                            -->
    <!-- CONTRAT_URL_COLLECTIONS.md §11, SPEC_IMPL_COLLECTIONS.md    -->
    <!-- §10 - MOA 2026-04-22 : affichage simple des collections     -->
    <!-- editoriales C-Kreyol auxquelles le produit est rattache.    -->
    <!--                                                            -->
    <!-- Resolution via le helper                                    -->
    <!-- product.template._ckr_get_visible_collections(website) qui  -->
    <!-- filtre le M2M ``ckr_collection_ids`` sur la visibilite      -->
    <!-- navigation publique (active + fenetre date_start/end +       -->
    <!-- website courant — SPEC_IMPL §2.2 / RC-03).                   -->
    <!--                                                            -->
    <!-- Rendu : liste a puces horizontale, chaque libelle cliquable -->
    <!-- vers ``/shop?ckr_collection=<slug>`` (conteneur unique).    -->
    <!-- Aucun lien /collections/union/... depuis la fiche (V1).      -->
    <!--                                                            -->
    <!-- Preuve auto : PV RC-13 — test_ckr_col_rc13_product_page_*   -->
    <!-- ========================================================== -->

    <template id="ckr_product_collections_block"
              inherit_id="website_sale.product"
              name="C-Kreyol: fiche produit - bloc Collections"
              priority="32">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-set="ckr_product_tmpl_col"
               t-value="product.product_tmpl_id if product._name == 'product.product' else product"/>
            <t t-set="ckr_collections_block"
               t-value="ckr_product_tmpl_col._ckr_get_visible_collections(website=website)"/>
            <section t-if="ckr_collections_block"
                     class="ckr-product-collections"
                     aria-label="Collections du produit">
                <span class="ckr-product-collections__label">Collections :</span>
                <ul class="ckr-product-collections__list">
                    <li t-foreach="ckr_collections_block"
                        t-as="ckr_collection"
                        class="ckr-product-collections__item">
                        <a t-att-href="'/shop?ckr_collection=%s' % ckr_collection.slug"
                           class="ckr-product-collections__link"
                           t-esc="ckr_collection.name"/>
                    </li>
                </ul>
            </section>
        </xpath>
    </template>

    <!-- ========================================================== -->
    <!-- Variantes fiche produit : exclure l'attribut "Origine"     -->
    <!--                                                            -->
    <!-- MVP2.3 : l'origine reste informative (bloc dédié),         -->
    <!-- jamais un choix interactif de variante sur la fiche.       -->
    <!-- ========================================================== -->
    <template id="ckr_product_variants_hide_origin_attribute"
              inherit_id="website_sale.variants"
              name="C-Kreyol: variantes fiche produit - masquer Origine"
              priority="33">
        <xpath expr="//t[@t-foreach='product.valid_product_template_attribute_line_ids']"
               position="attributes">
            <attribute name="t-if">ptal.attribute_id.id != request.env.ref('dorevia_ckreyol_marketplace.ckr_product_attribute_origin').id</attribute>
        </xpath>
    </template>

    <template id="ckr_product_reassurance_block"
              inherit_id="website_sale.product_terms_and_conditions"
              name="C-Kreyol: fiche produit - bloc réassurance structuré"
              priority="34">
        <xpath expr="//small" position="replace">
            <div class="ckr-product-reassurance" aria-label="Réassurance achat">
                <span class="ckr-product-reassurance__title o_translate_inline">Achat en confiance</span>
                <ul class="ckr-product-reassurance__list">
                    <li>
                        <i class="fa fa-lock" aria-hidden="true"/>
                        <span>Paiement sécurisé</span>
                    </li>
                    <li>
                        <i class="fa fa-truck" aria-hidden="true"/>
                        <span>Livraison : 2-3 jours ouvrables</span>
                    </li>
                    <li>
                        <i class="fa fa-check" aria-hidden="true"/>
                        <span>Satisfait ou remboursé 30 jours</span>
                    </li>
                </ul>
            </div>
        </xpath>
    </template>

    <template id="ckr_product_merchandising_sections"
              inherit_id="website_sale.product"
              name="C-Kreyol: fiche produit - sections éditoriales Lot 2"
              priority="35">
        <xpath expr="//div[@id='product_full_description']" position="attributes">
            <attribute name="class" add="d-none ckr-product-native-description-hidden" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='product_detail_main']" position="after">
            <t t-set="ckr_product_tmpl_sections"
               t-value="product.product_tmpl_id if product._name == 'product.product' else product"/>
            <t t-set="ckr_product_sections"
               t-value="ckr_product_tmpl_sections._ckr_get_product_detail_sections(website=website)"/>
            <section t-if="ckr_product_sections"
                     class="ckr-product-info"
                     aria-label="Informations produit">
                <header class="ckr-product-info__header">
                    <p class="ckr-product-info__eyebrow">Informations Produit</p>
                </header>
                <div class="ckr-product-info__list">
                    <details t-foreach="ckr_product_sections"
                             t-as="ckr_section"
                             t-att-open="'open' if ckr_section.get('open') else None"
                             class="ckr-product-info__item">
                        <summary class="ckr-product-info__summary">
                            <span t-esc="ckr_section.get('title')"/>
                        </summary>
                        <div class="ckr-product-info__body">
                            <p t-if="ckr_section.get('body')"
                               class="ckr-product-info__text"
                               t-esc="ckr_section.get('body')"/>
                            <dl t-if="ckr_section.get('lines')"
                                class="ckr-product-info__specs">
                                <t t-foreach="ckr_section.get('lines')" t-as="ckr_line">
                                    <div class="ckr-product-info__spec">
                                        <dt t-esc="ckr_line.get('label')"/>
                                        <dd t-esc="ckr_line.get('value')"/>
                                    </div>
                                </t>
                            </dl>
                        </div>
                    </details>
                </div>
            </section>
        </xpath>
    </template>

    <template id="ckr_product_recommendations"
              inherit_id="website_sale.product"
              name="C-Kreyol: fiche produit - Vous aimerez aussi"
              priority="36">
        <xpath expr="//div[@id='product_full_description']" position="after">
            <t t-set="ckr_product_tmpl_reco"
               t-value="product.product_tmpl_id if product._name == 'product.product' else product"/>
            <t t-set="ckr_recommendations"
               t-value="ckr_product_tmpl_reco._ckr_get_product_recommendation_templates(website=website, limit=4)"/>
            <section t-if="ckr_recommendations"
                     class="ckr-product-recos"
                     aria-label="Vous aimerez aussi">
                <div class="ckr-product-recos__inner">
                    <header class="ckr-product-recos__header">
                        <h2>Vous aimerez aussi</h2>
                        <a href="/shop" class="ckr-product-recos__link">Voir tout le catalogue</a>
                    </header>
                    <div class="ckr-product-recos__grid">
                        <article t-foreach="ckr_recommendations"
                                 t-as="ckr_reco"
                                 class="ckr-product-reco-card">
                            <a t-att-href="ckr_reco.website_url"
                               class="ckr-product-reco-card__media"
                               t-att-aria-label="ckr_reco.ck_product_name or ckr_reco.name">
                                <img t-att-src="ckr_reco._ckr_get_homepage_listing_image_url() or ckr_reco._ckr_get_homepage_listing_image_fallback_url()"
                                     t-att-alt="ckr_reco.ck_product_name or ckr_reco.name"
                                     loading="lazy"/>
                            </a>
                            <div class="ckr-product-reco-card__body">
                                <p t-if="ckr_reco._ckr_get_shop_tile_meta_line(website=website)"
                                   class="ckr-product-reco-card__meta"
                                   t-esc="ckr_reco._ckr_get_shop_tile_meta_line(website=website)"/>
                                <h3>
                                    <a t-att-href="ckr_reco.website_url"
                                       t-esc="ckr_reco.ck_product_name or ckr_reco.name"/>
                                </h3>
                                <t t-set="ckr_reco_price_info"
                                   t-value="ckr_reco._ckr_get_homepage_combination_info()"/>
                                <t t-set="ckr_reco_price"
                                   t-value="ckr_reco_price_info.get('price_reduce') or ckr_reco_price_info.get('price') or ckr_reco.list_price"/>
                                <div class="ckr-product-reco-card__footer">
                                    <strong t-out="ckr_reco_price"
                                            t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                    <a t-att-href="ckr_reco.website_url"
                                       class="ckr-product-reco-card__cta"
                                       aria-label="Voir ce produit">
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

</odoo>
