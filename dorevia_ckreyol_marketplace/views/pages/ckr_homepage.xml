<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Page homepage C-Kreyol                                     -->
    <!--                                                            -->
    <!-- Approche standard Odoo 19 CE :                             -->
    <!--   website.homepage est le template utilise par la          -->
    <!--   website.page "/" livree par Odoo (website.homepage_page).-->
    <!--   Son body est <div id="wrap" class="oe_structure          -->
    <!--   oe_empty"/> intentionnellement vide.                     -->
    <!--                                                            -->
    <!--   On herite ce template et on remplace le contenu de       -->
    <!--   #wrap par l assemblage de la variante "retail enrichie". -->
    <!--   => pas de duplication de website.page sur "/",           -->
    <!--      pas de conflit d URL, on reste dans le rail standard. -->
    <!--                                                            -->
    <!-- Reference : WIREFRAME_HOMEPAGE, SPEC_HERO_HOMEPAGE.         -->
    <!-- ========================================================== -->

    <!-- priority élevée : d'autres modules (thèmes démo, autres sites du
         mono-repo) peuvent aussi remplacer //div[@id='wrap'] sur
         website.homepage — la priorité doit laisser C-Kreyol « dernier mot ». -->
    <template id="ckr_page_homepage"
              inherit_id="website.homepage"
              name="C-Kreyol: Homepage (retail enrichie)"
              priority="2000">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="ckr-page ckr-root">

                <!-- Ne pas modifier sans ticket MOA : drapeau bas de page V1 —
                     0 = masque Fournisseur + Éditorial uniquement ; Cercle + Réassurance
                     toujours rendus. 1 = réaffiche Fournisseur + Éditorial (ordre gelé MOA). -->
                <t t-set="ckr_hpage_mvp1_tail_blocks" t-value="0"/>

                <!-- Bloc 2 : Hero (copy gele SPEC § 7) — INCHANGÉ -->
                <t t-call="dorevia_ckreyol_marketplace.ckr_snippet_hero"/>

                <!-- Bloc 3 : Entrees d exploration (Explorer) — INCHANGÉ -->
                <t t-call="dorevia_ckreyol_marketplace.ckr_snippet_entries"/>

                <!-- Bloc 4 : Fournisseur V1 (mise en avant La Platine, etc.) -->
                <t t-if="ckr_hpage_mvp1_tail_blocks" t-call="dorevia_ckreyol_marketplace.ckr_snippet_supplier"/>

                <!-- Bloc 5 : Selection produits (recette en cours) -->
                <t t-call="dorevia_ckreyol_marketplace.ckr_snippet_selection"/>

                <!-- Bloc 6 : Editorial V1 (gel MOA : avant Inscription quand tail V1 actif) -->
                <t t-if="ckr_hpage_mvp1_tail_blocks" t-call="dorevia_ckreyol_marketplace.ckr_snippet_editorial"/>

                <!-- Bloc inscription / Cercle C-Kreyol (MVP2.1 chantier 4/5) -->
                <t t-call="dorevia_ckreyol_marketplace.ckr_snippet_circle"/>

                <!-- Bloc 7 : Réassurance / confiance (MVP2 clôture — toujours rendu, avant footer) -->
                <t t-call="dorevia_ckreyol_marketplace.ckr_snippet_trust"/>

            </div>
        </xpath>
    </template>

</odoo>
