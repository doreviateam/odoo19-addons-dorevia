<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_ckr_activity" model="ir.ui.view">
        <field name="name">crm.lead.form.ckr.activity</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="ckr_activity_type"/>
                <field name="ckr_callback_date" optional="hide"/>
                <field name="ckr_callback_window" optional="hide"/>
                <field name="ckr_callback_slot" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
