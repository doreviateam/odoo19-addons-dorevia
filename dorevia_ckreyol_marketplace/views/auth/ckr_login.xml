<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- /web/login (website) : detechniciser, ton boutique, charte C-Kreyol. -->
    <!-- ================================================================== -->

    <template id="ckr_login_layout_scope"
              inherit_id="website.login_layout"
              name="C-Kreyol: login layout (scope CSS)">
        <xpath expr="//div[hasclass('oe_website_login_container')]" position="attributes">
            <attribute name="class" add="ckr-login-page" separator=" "/>
        </xpath>
    </template>

    <template id="ckr_web_login"
              inherit_id="web.login"
              name="C-Kreyol: login formulaire"
              priority="30">
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="before">
            <header class="ckr-login-page__head text-center">
                <h1 class="ckr-login-page__title">Mon compte</h1>
            </header>
        </xpath>

        <xpath expr="//div[hasclass('mb-3')][.//input[@name='db']]" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit' and not(@name)]" position="replace">
            <button type="submit" class="btn btn-primary ckr-login__submit">Se connecter</button>
        </xpath>

        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">Adresse e-mail</label>
        </xpath>
        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="placeholder">votre.email@exemple.com</attribute>
        </xpath>

        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label">Mot de passe</label>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="placeholder">Votre mot de passe</attribute>
        </xpath>

        <!-- Retire le sélecteur rapide d'utilisateurs (« Choisissez un utilisateur » — web.user_switch). -->
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
    </template>

    <template id="ckr_auth_signup_login"
              inherit_id="auth_signup.login"
              name="C-Kreyol: liens inscription / MDP oublie"
              priority="40">
        <xpath expr="//div[hasclass('oe_login_buttons')]/a[contains(@t-attf-href, '/web/signup')]" position="replace">
            <a t-if="signup_enabled"
               class="btn btn-link btn-sm mt-2 ckr-login__link-secondary"
               t-attf-href="/web/signup?{{ keep_query() }}">Créer un compte</a>
        </xpath>
        <xpath expr="//label[@for='password']/following-sibling::a[contains(@t-attf-href, 'reset_password')]" position="replace">
            <t/>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/a[contains(@t-attf-href, '/web/signup')]" position="after">
            <a t-if="reset_password_enabled"
               class="btn btn-link btn-sm mt-1 ckr-login__link-secondary"
               tabindex="2"
               t-attf-href="/web/reset_password?{{ keep_query() }}">Mot de passe oublié ?</a>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, '/web/signup')]" position="after">
            <p class="mt-3 mb-0 small text-center text-muted">
                <a href="/demande-compte-professionnel">Demande compte professionnel</a>
            </p>
        </xpath>
    </template>

    <template id="ckr_auth_signup_demande_pro"
              inherit_id="auth_signup.signup"
              name="C-Kreyol: lien demande compte pro"
              priority="45">
        <xpath expr="//a[contains(@t-attf-href, '/web/login')]" position="after">
            <p class="mt-3 mb-0 small text-muted text-center">
                Compte professionnel ?
                <a href="/demande-compte-professionnel">Demander l&apos;ouverture</a>
            </p>
        </xpath>
    </template>

</odoo>
