<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Nom commercial boutique (tuile /shop) — SPEC_CK_NOM_CK_TUILE_PRODUIT.md -->
    <record id="product_template_form_view_ck_product_name" model="ir.ui.view">
        <field name="name">product.template.form.ck.product.name</field>
        <field name="model">product.template</field>
        <field name="inherit_id"
               ref="dorevia_ckreyol_marketplace.product_template_form_view_ckr_origin"/>
        <field name="arch" type="xml">
            <field name="public_categ_ids" position="before">
                <field name="ck_product_name"
                       string="Nom CK"
                       placeholder="Nom affiché sur la boutique (tuile /shop)…"
                       invisible="not sale_ok"/>
            </field>
        </field>
    </record>

</odoo>
