<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- id historique conservé pour le chaînage homepage / snippets -->
    <template id="ckr_snippet_circle" name="C-Kreyol: Newsletter (homepage)">
        <t t-set="ck_ccnl" t-value="(request and request.httprequest and request.httprequest.args.get('cc_nl', '') or '')"/>
        <section class="ckr-section ckr-section--soft ckr-newsletter ckr-root" aria-labelledby="ckr-newsletter-heading">
            <div class="ckr-container">

                <div class="ckr-newsletter__messages"
                     t-if="ck_ccnl in ('ok', 'dup', 'invalid', 'err')">
                    <div t-if="ck_ccnl == 'ok'"
                         id="ckr-newsletter-status"
                         class="ckr-newsletter__msg ckr-newsletter__msg--ok"
                         role="status"
                         tabindex="-1">
                        Merci, votre inscription a bien été prise en compte.
                    </div>
                    <div t-if="ck_ccnl == 'dup'"
                         id="ckr-newsletter-status"
                         class="ckr-newsletter__msg ckr-newsletter__msg--info"
                         role="status"
                         tabindex="-1">
                        Cette adresse semble déjà inscrite à notre newsletter.
                    </div>
                    <div t-if="ck_ccnl == 'invalid'"
                         id="ckr-newsletter-feedback"
                         class="ckr-newsletter__msg ckr-newsletter__msg--err"
                         role="alert">
                        Veuillez saisir une adresse email valide.
                    </div>
                    <div t-if="ck_ccnl == 'err'"
                         id="ckr-newsletter-feedback"
                         class="ckr-newsletter__msg ckr-newsletter__msg--err"
                         role="alert">
                        L’inscription n’a pas pu être finalisée pour le moment. Vous pourrez réessayer dans quelques instants.
                    </div>
                </div>

                <div class="ckr-newsletter__main">
                    <div class="ckr-newsletter__copy">
                        <p class="ckr-newsletter__eyebrow">NEWSLETTER</p>
                        <h2 id="ckr-newsletter-heading" class="ckr-newsletter__title">
                            Recevez nos sélections, découvertes et nouvelles de C-Kréyòl
                        </h2>
                    </div>

                    <form class="ckr-newsletter__form"
                          action="/ckr/circle/subscribe"
                          method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="redirect" t-att-value="request.httprequest.path or '/'"/>

                        <div class="ckr-newsletter__field">
                            <label class="ckr-newsletter__label-vh" for="ckr-newsletter-email">E-mail</label>
                            <div class="ckr-newsletter__row">
                                <div class="ckr-newsletter__input-wrap">
                                    <input id="ckr-newsletter-email"
                                           class="ckr-newsletter__input"
                                           type="email"
                                           name="email"
                                           required="required"
                                           inputmode="email"
                                           autocomplete="email"
                                           placeholder="votre.adresse@email.com"
                                           aria-describedby="ckr-newsletter-legal"
                                           t-att-aria-invalid="'true' if ck_ccnl == 'invalid' else 'false'"/>
                                </div>
                                <button type="submit" class="ckr-btn ckr-btn--primary ckr-newsletter__submit">
                                    S’inscrire
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <hr class="ckr-newsletter__rule" aria-hidden="true"/>

                <p id="ckr-newsletter-legal" class="ckr-newsletter__legal">
                    Votre email est uniquement utilisé pour vous envoyer les nouvelles de C-Kréyòl,
                    nos sélections de produits et nos offres. Vous pouvez vous désabonner à tout moment
                    via le lien présent dans chaque email.
                </p>
            </div>
        </section>
    </template>

</odoo>
