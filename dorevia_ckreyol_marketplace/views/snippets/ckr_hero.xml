<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Snippet : Bloc 2 - Hero homepage (copy gele SPEC § 7)     -->
    <!-- ========================================================== -->

    <template id="ckr_snippet_hero" name="C-Kreyol: Hero homepage">
        <section class="ckr-hero ckr-root">
            <div class="ckr-hero__inner">

                <div class="ckr-hero__content">
                    <span class="ckr-hero__eyebrow">Agro transformés des Antilles</span>

                    <h1 class="ckr-hero__title">
                        C-Kreyol : une sélection d'agro transformés antillais
                    </h1>

                    <p class="ckr-hero__subtitle">
                        Biscuits, douceurs et épicerie des Antilles — sélectionnés avec soin pour
                        vous faire découvrir des origines lisibles et des saveurs authentiques.
                    </p>

                    <div class="ckr-hero__cta">
                        <a href="/shop" class="ckr-btn ckr-btn--primary ckr-btn--lg">
                            Découvrir la boutique
                        </a>
                        <a href="#explorer-catalogue" class="ckr-btn ckr-btn--secondary">
                            Explorer le catalogue
                        </a>
                    </div>
                </div>

                <div class="ckr-hero__visual">
                    <img src="/dorevia_ckreyol_marketplace/static/src/img/hero_macro.png"
                         alt="Biscuits et douceurs des Antilles — gros plan matière, lumière naturelle"
                         loading="eager"
                         fetchpriority="high"/>
                </div>

            </div>
        </section>
    </template>

</odoo>
