<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Snippet : Bloc 3 — Explorer / Par où commencer (MVP2)        -->
    <!-- Grille asymétrique 5 portes. Visuels : copies depuis        -->
    <!-- docs/assets/mvp02_reference_*.png → static/src/img/          -->
    <!-- explorer_porte_*.png (voir README, Références MVP 02).     -->
    <!-- Ancre : #explorer-catalogue                                  -->
    <!-- ========================================================== -->

    <template id="ckr_snippet_entries" name="C-Kreyol: Entrees d exploration">
        <section id="explorer-catalogue"
                 class="ckr-section ckr-root"
                 aria-labelledby="ckr-explorer-heading">
            <div class="ckr-container">

                <header class="ckr-section-title ckr-section-title--center">
                    <span class="ckr-section-title__eyebrow">Explorer</span>
                    <h2 id="ckr-explorer-heading">Par où commencer</h2>
                    <p class="ckr-section-title__intro">
                        Offres, coffrets, familles, coups de cœur, terroir.
                    </p>
                </header>

                <div class="ckr-entries__grid" role="navigation" aria-label="Portes d exploration du catalogue">

                    <a href="/shop?ckr_mode=promo"
                       class="ckr-entries__card ckr-entries__card--promo">
                        <div class="ckr-entries__card__media ckr-entries__card__media--promo" aria-hidden="true">
                            <img src="/dorevia_ckreyol_marketplace/static/src/img/explorer_porte_promotions.png"
                                 alt="" loading="lazy" class="ckr-entries__card__img"/>
                        </div>
                        <div class="ckr-entries__card__body">
                            <h3>Promotions</h3>
                            <p>Offres du moment et sélections à prix doux.</p>
                            <span class="ckr-entries__card__arrow">Voir les offres &#8594;</span>
                        </div>
                    </a>

                    <a href="/shop?ckr_mode=pack"
                       class="ckr-entries__card ckr-entries__card--kits">
                        <div class="ckr-entries__card__media ckr-entries__card__media--kits" aria-hidden="true">
                            <img src="/dorevia_ckreyol_marketplace/static/src/img/explorer_porte_kits.png"
                                 alt="" loading="lazy" class="ckr-entries__card__img"/>
                        </div>
                        <div class="ckr-entries__card__body">
                            <h3>Kits</h3>
                            <p>Coffrets et assortiments prêts à découvrir.</p>
                            <span class="ckr-entries__card__arrow">Découvrir les coffrets &#8594;</span>
                        </div>
                    </a>

                    <a href="/shop"
                       class="ckr-entries__card ckr-entries__card--tile">
                        <div class="ckr-entries__card__media ckr-entries__card__media--tile" aria-hidden="true">
                            <img src="/dorevia_ckreyol_marketplace/static/src/img/explorer_porte_categories.png"
                                 alt="" loading="lazy" class="ckr-entries__card__img"/>
                        </div>
                        <div class="ckr-entries__card__body">
                            <h3>Catégories</h3>
                            <p>Parcourez l’offre par familles de produits.</p>
                            <span class="ckr-entries__card__arrow">Parcourir &#8594;</span>
                        </div>
                    </a>

                    <a href="/shop?ckr_collection_scope=all"
                       class="ckr-entries__card ckr-entries__card--tile">
                        <div class="ckr-entries__card__media ckr-entries__card__media--tile" aria-hidden="true">
                            <img src="/dorevia_ckreyol_marketplace/static/src/img/explorer_porte_collections.png"
                                 alt="" loading="lazy" class="ckr-entries__card__img"/>
                        </div>
                        <div class="ckr-entries__card__body">
                            <h3>Collections</h3>
                            <p>Sélections éditoriales selon les saisons et les envies.</p>
                            <span class="ckr-entries__card__arrow">Voir les coups de cœur &#8594;</span>
                        </div>
                    </a>

                    <a href="/shop?ckr_mode=origin"
                       class="ckr-entries__card ckr-entries__card--tile">
                        <div class="ckr-entries__card__media ckr-entries__card__media--tile" aria-hidden="true">
                            <img src="/dorevia_ckreyol_marketplace/static/src/img/explorer_porte_origines.png"
                                 alt="" loading="lazy" class="ckr-entries__card__img"/>
                        </div>
                        <div class="ckr-entries__card__body">
                            <h3>Origines</h3>
                            <p>Découvrez les territoires et savoir-faire derrière les produits.</p>
                            <span class="ckr-entries__card__arrow">Parcourir les origines &#8594;</span>
                        </div>
                    </a>

                </div>

            </div>
        </section>
    </template>

</odoo>
