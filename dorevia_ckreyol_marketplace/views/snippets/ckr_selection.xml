<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Snippet : Bloc 5 - Sélection produits (MVP2.1)            -->
    <!-- 4 produits dynamiques website_sale — TICKET                -->
    <!-- SELECTION-PRODUITS-HOMEPAGE-MVP21,                         -->
    <!-- DECISION_PRODUITS_HOMEPAGE_MVP21.md                        -->
    <!-- Config : site Web → 4 champs Produit 1/4 … 4/4.           -->
    <!-- ========================================================== -->

    <template id="ckr_snippet_selection" name="C-Kreyol: Selection produits">
        <t t-set="ckr_sel_cards" t-value="website.sudo()._get_ckr_homepage_selection_cards()"/>
        <section class="ckr-section ckr-selection ckr-selection--band ckr-root">
            <div class="ckr-container">

                <header class="ckr-section-title ckr-section-title--center">
                    <span class="ckr-section-title__eyebrow ckr-section-title__eyebrow--rule">Sélection</span>
                    <h2>Notre sélection du moment</h2>
                    <p class="ckr-section-title__intro">
                        Quatre produits du catalogue, prix visiteur — ouvrez la fiche pour le détail.
                    </p>
                </header>

                <div t-if="ckr_sel_cards" class="ckr-selection__grid" role="list">
                    <t t-foreach="ckr_sel_cards" t-as="card">
                        <a t-att-href="card['product'].website_url"
                           class="ckr-selection__card"
                           role="listitem">
                            <div class="ckr-selection__card__img">
                                <!-- URL Odoo /web/image/... ou repli statique module (9.7) -->
                                <img t-if="card.get('listing_image_url')"
                                    t-att-src="card.get('listing_image_url')"
                                    t-att-alt="card['product'].name"
                                    loading="lazy"
                                    class="ckr-selection__card__image"/>
                                <div t-else="" class="ckr-selection__card__photo-fallback" aria-hidden="true">
                                    <span class="ckr-selection__card__photo-fallback-mark">C-K</span>
                                </div>
                            </div>
                            <div class="ckr-selection__card__head">
                                <h3 t-esc="card['product'].name"/>
                                <t t-set="ckr_comb" t-value="card.get('combination_info') or {}"/>
                                <span class="ckr-selection__card__price"
                                      t-esc="ckr_comb.get('price', 0)"
                                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            </div>
                            <p t-if="card.get('show_origin') and card.get('origin')"
                               class="ckr-selection__card__origin"
                               t-esc="card['origin']"/>
                            <span class="ckr-selection__card__product-cta">Voir le produit</span>
                        </a>
                    </t>
                </div>
                <div t-else="" class="ckr-selection__empty" role="status">
                    <p class="ckr-selection__empty-hint">
                        Aucun produit publié à mettre en avant pour le moment.
                        Indiquez jusqu’à quatre articles dans
                        <strong>Site web → Configuration → Sites</strong>
                        (groupe C-Kreyol), ou publiez des produits dans la boutique.
                    </p>
                </div>

                <div class="ckr-selection__cta">
                    <a href="/shop" class="ckr-btn ckr-btn--secondary">
                        Voir tous les produits
                    </a>
                </div>

            </div>
        </section>
    </template>

</odoo>
