<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Attribut catalogue « Origine » — source de vérité A1 (SPEC_IMPL §2.1).
         create_variant = never : pas de variante générée.
         display_type = multi : sélection multiple cohérente §13.1.
         Les valeurs (Martinique, Guadeloupe, …) se créent ensuite en
         back-office (Attributs produits) ; ce fichier ne fige que
         l’attribut pour que le domaine des vues CK reste résolvable. -->
    <record id="ckr_product_attribute_origin" model="product.attribute">
        <field name="name">Origine</field>
        <field name="create_variant">no_variant</field>
        <field name="display_type">multi</field>
        <field name="sequence">30</field>
    </record>

</odoo>
