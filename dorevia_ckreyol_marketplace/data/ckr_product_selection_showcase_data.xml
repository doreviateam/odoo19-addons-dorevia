<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
        Fiches « vitrine » — bloc homepage Sélection (MVP2.1).
        Visuels : copies banque `docs/assets/mvp02_reference_*.png` (sources
        MOA) vers `static/src/img/selection/ckr_sel_*.png` — voir migration
        19.0.1.9.7 si les binaires doivent être réinjectés.
        default_code : CKR-SEL-*.
        Câblage accueil si 4 champs vides : hook + migration 19.0.1.9.5,
        `website.ckr_ensure_showcase_featured_on_empty_websites`.
        -->
        <record id="product_template_ckr_sel_crepes" model="product.template">
            <field name="name">Crêpes</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product.product_category_goods"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="list_price" eval="4.5"/>
            <field name="default_code">CKR-SEL-CREPES</field>
            <field name="sale_ok" eval="True"/>
            <field name="active" eval="True"/>
            <field name="website_published" eval="True"/>
            <field name="is_published" eval="True"/>
            <field
                name="image_1920"
                type="base64"
                file="dorevia_ckreyol_marketplace/static/src/img/selection/ckr_sel_crepes.png"
            />
        </record>
        <record id="product_template_ckr_sel_biere" model="product.template">
            <field name="name">Bière</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product.product_category_goods"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="list_price" eval="2.6"/>
            <field name="default_code">CKR-SEL-BIERE</field>
            <field name="sale_ok" eval="True"/>
            <field name="active" eval="True"/>
            <field name="website_published" eval="True"/>
            <field name="is_published" eval="True"/>
            <field
                name="image_1920"
                type="base64"
                file="dorevia_ckreyol_marketplace/static/src/img/selection/ckr_sel_biere.png"
            />
        </record>
        <record id="product_template_ckr_sel_sucre" model="product.template">
            <field name="name">Sucre de canne</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product.product_category_goods"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="list_price" eval="3.2"/>
            <field name="default_code">CKR-SEL-SUCRE</field>
            <field name="sale_ok" eval="True"/>
            <field name="active" eval="True"/>
            <field name="website_published" eval="True"/>
            <field name="is_published" eval="True"/>
            <field
                name="image_1920"
                type="base64"
                file="dorevia_ckreyol_marketplace/static/src/img/selection/ckr_sel_sucre.png"
            />
        </record>
        <record id="product_template_ckr_sel_chips" model="product.template">
            <field name="name">Chips</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product.product_category_goods"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="list_price" eval="1.8"/>
            <field name="default_code">CKR-SEL-CHIPS</field>
            <field name="sale_ok" eval="True"/>
            <field name="active" eval="True"/>
            <field name="website_published" eval="True"/>
            <field name="is_published" eval="True"/>
            <field
                name="image_1920"
                type="base64"
                file="dorevia_ckreyol_marketplace/static/src/img/selection/ckr_sel_chips.png"
            />
        </record>
    </data>
</odoo>
