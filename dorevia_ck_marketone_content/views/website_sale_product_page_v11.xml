<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Zone haute V1.1 — métadonnées enrichies, badges qualifiés, prix absolus variantes -->

    <template id="product_ck_page_metadata_v11"
              inherit_id="dorevia_ck_marketone_content.product_ck_card_metadata"
              name="CK Product page metadata V1.1"
              priority="45">
        <xpath expr="//p[contains(@class, 'ck-product-purchase__meta')]" position="replace">
            <t t-set="ck_product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <p t-if="product.get_ck_product_page_metadata_line(ck_product_variant)"
               class="ck-product-purchase__meta ck-product-card__meta product-card-labels mb-0"
               t-out="product.get_ck_product_page_metadata_line(ck_product_variant)"/>
        </xpath>
    </template>

    <template id="product_ck_page_badges_v11"
              inherit_id="dorevia_ck_theme.product_ck_title_chips"
              name="CK Product page qualified badges"
              priority="45">
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="after">
            <ul t-if="product.ck_badge_ids"
                class="ck-product-purchase__badges list-unstyled d-flex flex-wrap gap-2 mb-2">
                <li t-foreach="product.ck_badge_ids" t-as="ck_badge"
                    class="ck-product-purchase__badge">
                    <span t-if="ck_badge.icon" class="ck-product-purchase__badge-icon" t-out="ck_badge.icon"/>
                    <span class="ck-product-purchase__badge-label" t-out="ck_badge.name"/>
                </li>
            </ul>
        </xpath>
    </template>

    <!-- CK-PROD-001 — Micro-ligne "sur commande" sous le prix -->
    <template id="product_ck_order_note"
              inherit_id="website_sale.product"
              name="CK Order note under price"
              priority="46">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]"
               position="after">
            <p t-if="product.ck_availability_mode == 'order'"
               class="ck-product-purchase__order-note">
                Pièce artisanale proposée sur commande
            </p>
        </xpath>
    </template>

    <!-- CK-PROD-001 — Bloc réassurance conditionnel (hérite theme, ne modifie pas le thème) -->
    <template id="product_ck_availability_reassurance"
              inherit_id="dorevia_ck_theme.product_ck_terms_fr"
              name="CK Availability-aware reassurance"
              priority="36">
        <xpath expr="//div[hasclass('ck-product-purchase__trust')]" position="replace">
            <div class="ck-product-purchase__trust">
                <t t-if="product.ck_availability_mode == 'order'">
                    <p class="ck-product-purchase__trust-strip">
                        Paiement sécurisé · Commande suivie · Accompagnement C-Kréyòl
                    </p>
                    <ul class="ck-product-purchase__trust-list">
                        <li>Sur commande · délai confirmé avant expédition</li>
                        <li>Livraison suivie avec emballage adapté</li>
                        <li>
                            <a href="/terms" class="o_translate_inline">
                                Conditions de retour applicables
                            </a>
                        </li>
                    </ul>
                </t>
                <t t-else="">
                    <p class="ck-product-purchase__trust-strip">
                        Paiement sécurisé · Livraison suivie · Expédié depuis Nantes
                    </p>
                    <ul class="ck-product-purchase__trust-list">
                        <li>En stock · Expédié depuis Nantes</li>
                        <li>Livraison suivie · 2 à 3 jours ouvrables</li>
                        <li>Retour selon CGV</li>
                    </ul>
                    <p class="ck-product-purchase__trust-legal mb-0">
                        <a href="/terms" class="o_translate_inline">Conditions générales de vente</a>
                    </p>
                </t>
            </div>
        </xpath>
    </template>

    <!-- CK-PROD-001 — CTA conditionnel (hérite theme, ne modifie pas le thème) -->
    <template id="product_ck_availability_cta"
              inherit_id="dorevia_ck_theme.product_ck_add_to_cart_fr"
              name="CK Availability-aware CTA label"
              priority="36">
        <xpath expr="//span[hasclass('ck-product-purchase__cart-label')]" position="replace">
            <span class="ck-product-purchase__cart-label"
                  t-if="product.ck_availability_mode == 'order'">
                Commander cette pièce
            </span>
            <span class="ck-product-purchase__cart-label" t-else="">
                Ajouter au panier
            </span>
        </xpath>
    </template>

    <template id="product_ck_variant_absolute_price_badge"
              inherit_id="website_sale.badge_extra_price"
              name="CK Product variant absolute price badge"
              priority="40">
        <!-- Remplace le signe +/- par le prix absolu CK -->
        <xpath expr="//span[hasclass('sign_badge_price_extra')]" position="replace">
            <t t-set="ck_variant_prices" t-value="product.get_ck_variant_value_prices(ptal)"/>
            <span t-if="ck_variant_prices.get(ptav.id)"
                  class="ck-product-purchase__variant-price ms-1"
                  t-out="ck_variant_prices.get(ptav.id)"/>
        </xpath>
        <!-- Masque le delta natif Odoo (abs(price_extra)) -->
        <xpath expr="//span[hasclass('variant_price_extra')]" position="replace"/>
    </template>
</odoo>
