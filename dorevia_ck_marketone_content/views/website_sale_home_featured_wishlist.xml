<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bouton wishlist card vedettes Home — même contrat Odoo que la grille /shop. -->
    <template id="ck_featured_card_wishlist_button" name="CK Featured card wishlist button">
        <t t-set="product_variant_id" t-value="product_variant.id if product_variant else product._get_first_possible_variant_id()"/>
        <t t-set="in_wish" t-value="product_variant and product_variant._is_in_wishlist()"/>
        <button t-if="product_variant_id"
                type="button"
                t-attf-class="btn o_add_wishlist ck-product-card__favorite #{'o_in_wishlist' if in_wish else ''}"
                t-att-data-product-template-id="product.id"
                t-att-data-product-product-id="product_variant_id"
                data-action="o_wishlist"
                t-att-title="'Retirer de la liste' if in_wish else 'Ajouter à la liste de souhaits'"
                t-att-aria-label="'Retirer de la liste' if in_wish else 'Ajouter à la liste de souhaits'">
            <span t-attf-class="fa o_not-animable #{'fa-heart' if in_wish else 'fa-heart-o'}" role="presentation"/>
            <span class="o_label small ms-2">Ajouter à la liste de souhaits</span>
        </button>
    </template>
</odoo>
