<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ck_producer_detail_page" name="CK Producteur — Fiche">
        <t t-call="website.layout">
            <t t-set="title"><t t-esc="producer.name"/> — Producteur partenaire | C-Kréyòl</t>
            <t t-set="website_meta_description" t-value="meta_description"/>
            <div id="wrap" class="ck-producer-detail">
                <div class="container py-5">

                    <!-- Lien retour -->
                    <a href="/producteurs" class="ck-producer-detail__back">
                        <i class="fa fa-arrow-left me-1" aria-hidden="true"/>
                        Tous nos producteurs
                    </a>

                    <!-- En-tête producteur -->
                    <div class="ck-producer-detail__header row align-items-start g-4 mt-3">
                        <div class="col-12 col-md-4 col-lg-3">
                            <div class="ck-producer-detail__media ck-producer-hero__image">
                                <img t-if="producer.get_ck_producer_image_url()"
                                     t-att-src="producer.get_ck_producer_image_url('image_1920')"
                                     t-att-alt="producer.name"
                                     class="ck-producer-detail__img"
                                     loading="eager"
                                     decoding="async"/>
                                <div t-else="" class="ck-producer-detail__img-placeholder" aria-hidden="true">
                                    <i class="fa fa-leaf fa-3x"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-8 col-lg-9">
                            <h1 class="ck-producer-detail__title" t-esc="producer.name"/>
                            <p t-if="producer.ck_producer_location_label"
                               class="ck-producer-detail__origin"
                               t-esc="producer.ck_producer_location_label"/>
                            <p t-if="producer.ck_producer_short_description"
                               class="ck-producer-detail__short-desc"
                               t-esc="producer.ck_producer_short_description"/>
                            <t t-if="producer.ck_producer_story_html">
                                <div class="ck-producer-detail__story"
                                     t-out="producer.ck_producer_story_html"/>
                            </t>
                            <a t-if="producer.website"
                               t-att-href="producer.website"
                               class="ck-producer-detail__website-link"
                               target="_blank"
                               rel="noopener noreferrer">
                                <i class="fa fa-external-link me-1" aria-hidden="true"/>
                                <t t-esc="producer.website"/>
                            </a>
                        </div>
                    </div>

                    <!-- Produits associés -->
                    <section class="ck-producer-detail__products-section mt-5" t-if="products">
                        <h2 class="ck-producer-detail__products-title h4 mb-4">Produits de ce producteur</h2>
                        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                            <t t-foreach="products" t-as="product">
                                <div class="col">
                                    <a t-att-href="product.website_url"
                                       class="ck-producer-detail__product text-decoration-none d-block h-100">
                                        <div class="ck-producer-detail__product-media ratio ratio-1x1">
                                            <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                 t-att-alt="product.name"
                                                 class="ck-producer-detail__product-img"
                                                 loading="lazy"
                                                 decoding="async"/>
                                        </div>
                                        <p class="ck-producer-detail__product-name"
                                           t-esc="product.name"/>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </section>

                </div>
            </div>
        </t>
    </template>
</odoo>
