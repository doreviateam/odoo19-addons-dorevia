<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ck_featured_card" model="ir.ui.view">
        <field name="name">product.template.form.ck.featured.card</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='extra_info']" position="inside">
                <group string="Card home Nos coups de cœur" name="ck_featured_card_info">
                    <field name="ck_featured_label_ids"
                           widget="many2many_tags"
                           options="{'no_create_edit': False}"/>
                    <field name="ck_net_quantity"/>
                    <field name="ck_net_quantity_uom"/>
                    <field name="ck_reference_price_uom"/>
                    <field name="ck_show_reference_price"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
