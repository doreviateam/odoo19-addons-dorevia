<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ck_featured_card" model="ir.ui.view">
        <field name="name">product.template.form.ck.ecommerce.bo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='extra_info']" position="replace">
                <group name="extra_info" string="Boutique eCommerce" colspan="2">
                    <group string="Publication" name="ck_ecom_publication">
                        <field name="is_published"
                               widget="boolean_toggle"
                               string="Est publié"/>
                        <field name="website_id"
                               options="{'no_create': True}"
                               groups="website.group_multi_website"
                               placeholder="Tous les sites"/>
                    </group>
                    <group string="Classement boutique" name="ck_ecom_catalog">
                        <field name="public_categ_ids"
                               widget="many2many_tags"
                               string="Catégories"/>
                        <field name="website_ribbon_id"
                               string="Ruban"
                               options="{'no_quick_create': True}"/>
                        <field name="product_tag_ids"
                               widget="many2many_tags"
                               string="Étiquettes produit"
                               context="{'product_template_id': id}"/>
                        <field name="website_sequence" groups="base.group_no_one"/>
                    </group>
                    <div class="alert alert-secondary mb-2 mt-2" role="alert" colspan="2">
                        <strong>Card home — Nos coups de cœur</strong>
                        <p class="mb-0">
                            Champs utilisés uniquement pour la card affichée sur la page d'accueil,
                            section « Nos coups de cœur ».
                        </p>
                    </div>
                    <group string="Affichage card" name="ck_featured_card_display">
                        <field name="ck_featured_label_ids"
                               widget="many2many_tags"
                               string="Étiquettes visibles sur la card"
                               placeholder="Réunion, Épicerie…"
                               options="{'no_create_edit': False}"/>
                        <div class="text-muted" colspan="2">
                            Affichées sous le nom du produit sur la card (ex. Réunion · Épicerie).
                        </div>
                    </group>
                    <group string="Quantité commerciale" name="ck_featured_card_quantity">
                        <field name="ck_net_quantity" placeholder="ex. 320"/>
                        <field name="ck_net_quantity_uom"/>
                        <field name="ck_show_reference_price"/>
                        <field name="ck_reference_price_uom"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
