<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Zone 0 + zone longue (ancres) — données parser + masquage blocs natifs redondants -->

    <!-- Chips-U2 — producteur nommé : remplace "Producteur identifié" générique.
         Hérite product_ck_title_chips (priority 30) qui injecte le chips div après h1.
         Priority 50 > product_ck_card_metadata (34) : le chips div est déjà modifié
         par la metadata avant que Chips-U2 ne remplace son contenu. -->
    <template id="product_ck_chips_u2"
              inherit_id="dorevia_ck_theme.product_ck_title_chips"
              name="CK Chips-U2 — producteur nommé"
              priority="50">
        <xpath expr="//div[hasclass('ck-product-purchase__chips')]" position="replace">
            <div class="ck-product-purchase__chips">
                <t t-foreach="product.get_ck_product_page_chips()" t-as="chip">
                    <a t-if="chip['categ']"
                       t-attf-href="/shop/category/{{slug(chip['categ'])}}"
                       class="ck-chip"
                       t-esc="chip['name']"/>
                    <a t-elif="chip.get('producer_url')"
                       t-att-href="chip['producer_url']"
                       class="ck-chip ck-chip--producer"
                       t-esc="chip['name']"/>
                    <span t-else=""
                          class="ck-chip"
                          t-esc="chip['name']"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="product_ck_card_metadata"
              inherit_id="dorevia_ck_theme.product_ck_title_chips"
              name="CK Product page metadata line"
              priority="34">
        <!-- Ancre = chips div injecté par product_ck_title_chips (priority 30).
             Si le produit n'a pas de catégorie, le chips div est vide (hidden :empty)
             mais reste dans le DOM — la metadata s'affiche toujours juste sous le titre. -->
        <xpath expr="//div[hasclass('ck-product-purchase__chips')]" position="after">
            <t t-set="ck_product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <p t-if="product.get_ck_shop_card_metadata_line(ck_product_variant)"
               class="ck-product-purchase__meta mb-0"
               t-out="product.get_ck_shop_card_metadata_line(ck_product_variant)"/>
        </xpath>
    </template>

    <template id="product_ck_tabs_data"
              inherit_id="website_sale.product"
              name="CK Product tabs data"
              priority="33">
        <xpath expr="//div[@id='wrap']" position="before">
            <t t-set="ck_product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <t t-set="ck_product_page_tabs"
               t-value="product.get_ck_product_page_tabs(ck_product_variant)"/>
            <t t-set="ck_product_detail_sections"
               t-value="product.get_ck_product_page_detail_sections()"/>
            <t t-set="ck_related_products"
               t-value="product.get_ck_related_products()"/>
        </xpath>
        <xpath expr="//div[@id='product_full_description']" position="attributes">
            <attribute name="t-if">not ck_product_page_tabs</attribute>
        </xpath>
    </template>
</odoo>
