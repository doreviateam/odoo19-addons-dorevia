<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Zone 0 + zone longue (ancres) — données parser + masquage blocs natifs redondants -->

    <template id="product_ck_card_metadata"
              inherit_id="dorevia_ck_theme.product_ck_title_chips"
              name="CK Product page metadata line"
              priority="40">
        <xpath expr="//div[contains(@t-attf-class, 'o_wsale_product_details_content_section_title')]//h1" position="after">
            <t t-set="ck_product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <p t-if="product.get_ck_shop_card_metadata_line(ck_product_variant)"
               class="ck-product-purchase__meta ck-product-card__meta product-card-labels mb-0"
               t-out="product.get_ck_shop_card_metadata_line(ck_product_variant)"/>
        </xpath>
    </template>

    <template id="product_ck_tabs_data"
              inherit_id="website_sale.product"
              name="CK Product tabs data"
              priority="33">
        <xpath expr="//div[@id='wrap']" position="before">
            <t t-set="ck_product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <t t-set="ck_product_page_tabs"
               t-value="product.get_ck_product_page_tabs(ck_product_variant)"/>
            <t t-set="ck_product_detail_sections"
               t-value="product.get_ck_product_page_detail_sections()"/>
        </xpath>
        <xpath expr="//div[@id='product_full_description']" position="attributes">
            <attribute name="t-if">not ck_product_page_tabs</attribute>
        </xpath>
    </template>
</odoo>
