<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ck_mega_menu_rayon_visual_tree" model="ir.ui.view">
        <field name="name">ck.mega.menu.rayon.visual.tree</field>
        <field name="model">ck.mega.menu.rayon.visual</field>
        <field name="arch" type="xml">
            <list>
                <field name="menu_key"/>
                <field name="title"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ck_mega_menu_rayon_visual_form" model="ir.ui.view">
        <field name="name">ck.mega.menu.rayon.visual.form</field>
        <field name="model">ck.mega.menu.rayon.visual</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="menu_key"/>
                        <field name="active"/>
                    </group>
                    <group string="Visuel éditorial du rayon">
                        <field name="image" widget="image" class="oe_avatar"/>
                        <field name="title"/>
                        <field name="subtitle"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Ce visuel illustre le rayon (ambiance, territoire, sélection) — il
                        ne doit pas représenter un produit unique présenté comme
                        emblématique du rayon entier. Distinct des campagnes saisonnières
                        (menu « Blocs visuels mega-menu »), qui restent prioritaires si
                        une campagne est active.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ck_mega_menu_rayon_visual" model="ir.actions.act_window">
        <field name="name">Visuels éditoriaux par rayon</field>
        <field name="res_model">ck.mega.menu.rayon.visual</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ck_mega_menu_rayon_visual"
              name="Visuels rayon mega-menu (identité)"
              parent="website.menu_website_configuration"
              action="action_ck_mega_menu_rayon_visual"
              sequence="47"
              groups="website.group_website_designer"/>
</odoo>
