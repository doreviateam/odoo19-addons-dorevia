<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Note 07 Lot C — bloc rebond rayon pauvre.
         Injecté avant oe_structure_2 (après la grille produits).
         ck_show_rebound est positionné par CkWebsiteSaleController._get_additional_shop_values.
         Condition D5 : category défini · 0 < search_count < 3 · pas de recherche · pas de filtre. -->
    <template id="website_sale_shop_rebound"
              inherit_id="website_sale.products"
              name="CK — Bloc rebond rayon pauvre (Note 07 Lot C)"
              priority="40">
        <xpath expr="//div[@id='oe_structure_website_sale_products_2']" position="before">
            <section t-if="ck_show_rebound" class="ck-shop-rebound">
                <div class="container">
                    <p class="ck-shop-rebound__message"
                       t-esc="ck_rebound_message"/>
                    <a t-att-href="ck_rebound_cta_url"
                       class="btn btn-outline-primary ck-shop-rebound__cta"
                       t-esc="ck_rebound_cta_label"/>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
