<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ck_product_badge_view_tree" model="ir.ui.view">
        <field name="name">ck.product.badge.tree</field>
        <field name="model">ck.product.badge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="badge_type"/>
                <field name="icon"/>
                <field name="requires_validation"/>
                <field name="is_sensitive_claim"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ck_product_badge_view_form" model="ir.ui.view">
        <field name="name">ck.product.badge.form</field>
        <field name="model">ck.product.badge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="badge_type"/>
                            <field name="icon"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="requires_validation"/>
                            <field name="is_sensitive_claim"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ck_product_badge_action" model="ir.actions.act_window">
        <field name="name">Badges produit CK</field>
        <field name="res_model">ck.product.badge</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ck_product_badge"
              name="Badges produit CK"
              parent="website_sale.menu_catalog"
              action="ck_product_badge_action"
              sequence="45"
              groups="sales_team.group_sale_manager,website.group_website_designer"/>
</odoo>
