<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bannière univers shop — couvre /shop (boutique) + 4 univers racines
         + sous-catégories par héritage ck_universe (V1 validé MOA 27/06/2026).
         Retourne toujours un dict {title, phrase} ; familles/highlights en plus
         pour Épicerie quand les seuils catalogue sont atteints. -->
    <template id="website_sale_rayon_editorial"
              inherit_id="dorevia_ck_theme.products_ck_shop_compose"
              name="CK Bannière univers shop — V1">
        <xpath expr="//t[@t-call='dorevia_ck_theme.s_ck_shop_intro']" position="attributes">
            <attribute name="t-if">not ck_rayon</attribute>
        </xpath>
        <xpath expr="//t[@t-call='dorevia_ck_theme.s_ck_shop_intro']" position="before">
            <t t-set="ck_rayon" t-value="request.env['product.public.category'].sudo().get_ck_shop_banner(category)"/>

            <!-- Bannière de rayon — repère MOA (Abbaye de Sept-Fons) : bloc
                 colonne pleine largeur, titre + phrase en clair sur fond couleur. -->
            <section t-if="ck_rayon" class="ck-rayon-banner" data-snippet="ck_rayon_banner">
                <div class="container">
                    <h1 class="ck-rayon-banner__title" t-esc="ck_rayon['title']"/>
                    <p class="ck-rayon-banner__phrase" t-esc="ck_rayon['phrase']"/>
                </div>
            </section>

            <!-- Répertoire visuel des sous-familles — cercles photo produit réel,
                 fallback texte "Aucune image disponible" si aucune photo (jamais
                 d'image générique inventée), même principe que le repère fourni. -->
            <section t-if="ck_rayon and ck_rayon.get('families')" class="ck-rayon-families">
                <div class="container">
                    <div class="row g-4 justify-content-center justify-content-md-start">
                        <div class="col-4 col-md-2" t-foreach="ck_rayon['families']" t-as="ck_family">
                            <a t-att-href="ck_family['url']" class="ck-rayon-family-tile">
                                <span class="ck-rayon-family-tile__media">
                                    <img t-if="ck_family['image_url']" t-att-src="ck_family['image_url']"
                                         t-att-alt="ck_family['label']" loading="lazy"/>
                                    <span t-else="" class="ck-rayon-family-tile__placeholder">Aucune image disponible</span>
                                </span>
                                <span class="ck-rayon-family-tile__label" t-esc="ck_family['label']"/>
                            </a>
                        </div>
                    </div>
                    <p t-if="ck_rayon.get('proof')" class="ck-rayon-families__proof" t-esc="ck_rayon['proof']"/>
                </div>
            </section>

            <section t-if="ck_rayon and ck_rayon.get('highlights')" class="container ck-rayon-header__highlights">
                <div class="row g-3">
                    <div class="col-md-4" t-foreach="ck_rayon['highlights']" t-as="ck_highlight">
                        <a t-att-href="ck_highlight['url']" class="ck-rayon-highlight">
                            <span class="ck-rayon-highlight__title" t-esc="ck_highlight['title']"/>
                            <span class="ck-rayon-highlight__text" t-esc="ck_highlight['text']"/>
                        </a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- Le header natif (titre H1 + description catégorie) duplique le header de
         rayon ci-dessus quand celui-ci est actif — on le masque dans ce seul cas
         (il reste affiché normalement sur /shop et sur les rayons non publiables). -->
    <template id="website_sale_rayon_editorial_hide_native_title"
              inherit_id="website_sale.products"
              name="CK Rayon éditorial — masque titre natif dupliqué"
              priority="40">
        <xpath expr="//header[@id='o_wsale_products_header']//h1" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//h1[hasclass('o_wsale_shop_title')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='category_header']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
