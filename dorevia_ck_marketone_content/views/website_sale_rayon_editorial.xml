<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CK-UNIVERSE-BANNER-001 Lot A — banner éditorial complet (image native,
         accroche, accent terracotta) sur les catégories e-commerce niveau 0 ;
         titre compact Shop-U3 conservé en fallback pour /shop général et
         les sous-catégories. -->
    <template id="website_sale_rayon_editorial"
              inherit_id="dorevia_ck_theme.products_ck_shop_compose"
              name="CK Banner univers / titre compact — Note 09 Lot A">
        <xpath expr="//t[@t-call='dorevia_ck_theme.s_ck_shop_intro']" position="attributes">
            <attribute name="t-if">not ck_rayon</attribute>
        </xpath>
        <xpath expr="//t[@t-call='dorevia_ck_theme.s_ck_shop_intro']" position="before">
            <t t-set="ck_rayon" t-value="request.env['product.public.category'].sudo().get_ck_shop_banner(category)"/>
            <t t-set="ck_univers_banner" t-value="bool(ck_rayon and category and not category.parent_id)"/>

            <!-- Banner Univers — catégories e-commerce niveau 0 uniquement. -->
            <section t-if="ck_univers_banner"
                     t-attf-class="ck-univers-banner #{'ck-univers-banner--no-image' if not ck_rayon['image_url'] else ''}">
                <img t-if="ck_rayon['image_url']" t-att-src="ck_rayon['image_url']"
                     alt="" aria-hidden="true" loading="lazy"/>
                <div class="ck-univers-banner__scrim"/>
                <div class="container">
                    <span class="ck-univers-banner__eyebrow">Univers</span>
                    <h1 class="ck-univers-banner__title" t-esc="ck_rayon['title']"/>
                    <p t-if="ck_rayon.get('subtitle')" class="ck-univers-banner__subtitle" t-esc="ck_rayon['subtitle']"/>
                    <div class="ck-univers-banner__accent"/>
                </div>
            </section>

            <!-- H1 compact — fallback /shop général et sous-catégories (inchangé Shop-U3). -->
            <section t-if="ck_rayon and not ck_univers_banner" class="ck-shop-intro ck-shop-intro--title-only">
                <div class="container">
                    <h1 class="ck-section-title ck-shop-intro__title mb-0" t-esc="ck_rayon['title']"/>
                </div>
            </section>
        </xpath>
    </template>

    <!-- Masque le titre natif Odoo uniquement quand le H1 CK univers est actif
         (évite double H1 ; si ck_rayon absent, le natif reste la source). -->
    <template id="website_sale_rayon_editorial_hide_native_title"
              inherit_id="website_sale.products"
              name="CK Shop univers — masque titre natif si H1 CK actif"
              priority="40">
        <xpath expr="//header[@id='o_wsale_products_header']/h1[1]" position="attributes">
            <attribute name="t-if">(category or search) and not ck_rayon</attribute>
        </xpath>
        <xpath expr="//h1[hasclass('o_wsale_shop_title')]" position="attributes">
            <attribute name="t-if">not category and not search and not ck_rayon</attribute>
        </xpath>
        <xpath expr="//div[@id='category_header']" position="attributes">
            <attribute name="t-if">category and not ck_rayon</attribute>
        </xpath>
    </template>
</odoo>
