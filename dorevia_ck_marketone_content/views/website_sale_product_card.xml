<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ligne secondaire card boutique — réutilise la logique métadonnées des vedettes home. -->
    <template id="products_item_ck_card_metadata"
              inherit_id="dorevia_ck_theme.products_item_ck_card"
              name="CK Shop product card metadata"
              priority="45">
        <!-- Ticket Dev — P2A densification : eyebrow origine au-dessus du titre
             (donnée déjà calculée pour la ligne meta, juste affichée à part —
             pas de nouvelle source, pas de "marque" inventée). -->
        <xpath expr="//h2[hasclass('ck-product-card__title')]" position="before">
            <t t-set="ck_shop_variant_origin" t-value="product_variant or product_variants[product]"/>
            <p t-if="product.get_ck_shop_card_origin_label(ck_shop_variant_origin)"
               class="ck-product-card__origin mb-0"
               t-out="product.get_ck_shop_card_origin_label(ck_shop_variant_origin)"/>
        </xpath>
        <xpath expr="//h2[hasclass('ck-product-card__title')]" position="after">
            <t t-set="ck_shop_variant" t-value="product_variant or product_variants[product]"/>
            <p t-if="product.get_ck_shop_card_metadata_line(ck_shop_variant)"
               class="ck-product-card__meta product-card-labels mb-0"
               t-out="product.get_ck_shop_card_metadata_line(ck_shop_variant)"/>
        </xpath>
    </template>
</odoo>
