<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ck_card_uom_view_list" model="ir.ui.view">
        <field name="name">dorevia.ck.card.uom.list</field>
        <field name="model">dorevia.ck.card.uom</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="family"/>
                <field name="ratio"/>
                <field name="use_for_net_quantity"/>
                <field name="use_for_reference_price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ck_card_uom_view_form" model="ir.ui.view">
        <field name="name">dorevia.ck.card.uom.form</field>
        <field name="model">dorevia.ck.card.uom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="family"/>
                            <field name="ratio"/>
                            <field name="use_for_net_quantity"/>
                            <field name="use_for_reference_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ck_card_uom_action" model="ir.actions.act_window">
        <field name="name">Unités card home</field>
        <field name="res_model">dorevia.ck.card.uom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Définissez les unités utilisables sur les cards produit de la home.
            </p>
            <p>
                Ex. g, kg, ml, l, pièce — avec le ratio de conversion vers kg ou l pour le prix de référence.
            </p>
        </field>
    </record>

    <menuitem id="ck_card_uom_menu"
              name="Unités card home"
              parent="website.menu_website_configuration"
              action="ck_card_uom_action"
              sequence="46"
              groups="sales_team.group_sale_manager"/>
</odoo>
