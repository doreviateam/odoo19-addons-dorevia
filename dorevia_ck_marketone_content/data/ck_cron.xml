<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- PR-3 (H2) — sync vedettes accueil hors requête (remplace l'auto-heal GET).
             Couvre les cas hors-ORM / edge ; les write-triggers ORM gardent la
             fraîcheur immédiate. noupdate=1 : l'activation admin survit aux upgrades. -->
        <record id="ck_cron_sync_home_featured" model="ir.cron">
            <field name="name">CK — Sync vedettes accueil (étiquettes BO périmées)</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._ck_sync_home_featured_labels_on_startup()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(minutes=30))"/>
        </record>
    </data>
</odoo>
