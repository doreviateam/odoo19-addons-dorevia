<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_cash_guard_recompute_system_reference" model="ir.cron">
        <field name="name">Cash Guard — Recalcul projection de référence système</field>
        <field name="model_id" ref="model_dorevia_cash_guard"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_system_reference_projections()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_cash_guard_recompute_open_points" model="ir.cron">
        <field name="name">Cash Guard — Recalcul des projections ouvertes</field>
        <field name="model_id" ref="model_dorevia_cash_guard"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_open_points()</field>
        <field name="active" eval="False"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
