<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dorevia_cash_guard_tree" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.tree</field>
        <field name="model">dorevia.cash.guard</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="periodicity" optional="show"/>
                <field name="situation_date" optional="show"/>
                <field name="liquidity_journal_ids" widget="many2many_tags" optional="show"/>
                <field name="alert_threshold"/>
                <field name="observed_balance"/>
                <field name="forecast_final_balance" string="Projection fin période"/>
                <field name="forecast_min_balance" string="Projection min."/>
                <field name="risk_status"/>
            </list>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_search" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.search</field>
        <field name="model">dorevia.cash.guard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="situation_date"/>
                <field name="liquidity_journal_ids"/>
                <field name="company_id"/>
                <filter name="filter_risk" string="Risque" domain="[('risk_status', '=', 'risk')]"/>
                <separator/>
                <filter name="filter_active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_line_tree" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.line.tree</field>
        <field name="model">dorevia.cash.guard.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="projection_date asc,sequence asc,id asc">
                <field name="projection_date"/>
                <field name="sequence"/>
                <field name="budget_post_id"/>
                <field name="label"/>
                <field name="line_type"/>
                <field name="direction"/>
                <field name="projected_amount"/>
                <field name="signed_projected_amount" readonly="1"/>
                <field name="realized_amount"/>
                <field name="signed_realized_amount" readonly="1"/>
                <field name="variance_amount" readonly="1"/>
                <field name="balance_after_line" readonly="1"/>
                <field name="cash_state"/>
            </list>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_line_search" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.line.search</field>
        <field name="model">dorevia.cash.guard.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="budget_post_id"/>
                <field name="guard_id"/>
                <field name="line_type"/>
                <field name="cash_state"/>
                <filter name="filter_planned" string="Prévu" domain="[('line_type', '=', 'planned')]"/>
                <filter name="filter_simulated" string="Simulé" domain="[('line_type', '=', 'simulated')]"/>
                <filter name="filter_reconciled" string="Rapproché" domain="[('cash_state', '=', 'reconciled')]"/>
            </search>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_form" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.form</field>
        <field name="model">dorevia.cash.guard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reset_period_to_defaults" type="object"
                            string="Réinitialiser"
                            class="btn-secondary"
                            invisible="not active"
                            title="Remet les dates sur la situation à date et une fin à +90 jours, puis recalcule la projection."/>
                    <!-- Recalcul automatique à l’ouverture ; entrée technique équivalente au réalignement +90 j. -->
                    <button name="action_recompute_projection" type="object" string="Actualiser et réaligner la période"
                            class="btn-secondary" invisible="1"
                            context="{'cash_guard_actualiser_realign': True}"/>
                    <button name="action_archive" type="object" string="Archiver" class="btn-secondary"
                            invisible="not active"/>
                    <button name="action_unarchive" type="object" string="Restaurer" class="btn-secondary"
                            invisible="active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="state" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="responsible_id"/>
                            <field name="liquidity_journal_ids" widget="many2many_tags"
                                   domain="[('type','in',('bank','cash')), ('company_id','=', company_id)]"/>
                            <field name="bank_journal_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="periodicity"/>
                            <field name="alert_threshold"/>
                            <field name="risk_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Synthèse">
                        <group string="Situation constatée">
                            <field name="situation_date" readonly="1"/>
                            <field name="observed_balance" readonly="1"/>
                        </group>
                        <group string="Projection">
                            <field name="forecast_final_balance"
                                   string="Projection en fin de période"
                                   readonly="1"/>
                            <field name="forecast_min_balance"
                                   string="Projection minimum"
                                   readonly="1"/>
                            <field name="min_balance_date"
                                   string="Date du point bas projeté"
                                   readonly="1"/>
                            <field name="forecast_min_margin"
                                   string="Couverture minimum"
                                   readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suivi de trésorerie">
                            <field name="weekly_line_ids" readonly="1">
                                <list default_order="week_index asc"
                                      decoration-danger="projected_balance &lt;= 0"
                                      decoration-warning="projected_balance &gt; 0 and projected_balance &lt;= alert_threshold"
                                      decoration-success="projected_balance &gt; alert_threshold">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="alert_threshold" column_invisible="1"/>
                                    <field name="week_label"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="period_type" string="État"/>
                                    <field name="closing_balance"
                                           column_invisible="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="projected_balance" string="Projection"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="margin_amount" string="Couverture"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="risk_status" string="Statut"/>
                                </list>
                            </field>
                        </page>
                        <!-- Masqué tant que le rôle métier des flux manuels n’est pas recadré (invisible inconditionnelle : ni groupe_no_one ni admin ne réaffichent l’onglet). Modèle + menu « Flux complémentaires » inchangés. -->
                        <page string="Flux complémentaires" invisible="1">
                            <field name="line_ids" context="{'default_projection_date': date_from}">
                                <list editable="bottom" default_order="projection_date asc,sequence asc,id asc">
                                    <field name="projection_date"/>
                                    <field name="sequence"/>
                                    <field name="budget_post_id"/>
                                    <field name="label"/>
                                    <field name="line_type"/>
                                    <field name="direction"/>
                                    <field name="projected_amount"/>
                                    <field name="signed_projected_amount" readonly="1"/>
                                    <field name="realized_amount"/>
                                    <field name="signed_realized_amount" readonly="1"/>
                                    <field name="variance_amount" readonly="1"/>
                                    <field name="balance_after_line" readonly="1"/>
                                    <field name="cash_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Détail projection">
                            <field name="projection_period_move_ids" readonly="1">
                                <list default_order="sequence asc, id asc">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="week_label" string="Période"/>
                                    <field name="week_invoice_net_amount" string="Impact net période"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="week_invoice_move_count" string="Nb pièces"/>
                                    <field name="projected_date" string="Date projetée"/>
                                    <field name="move_name" string="Pièce"/>
                                    <field name="move_id" optional="hide"/>
                                    <field name="partner_id" string="Partenaire"/>
                                    <field name="move_type" string="Type"/>
                                    <field name="invoice_date_due" string="Échéance"/>
                                    <field name="signed_amount" string="Impact"
                                           widget="monetary"
                                           sum="Impact net"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="is_overdue_label" string="Échue"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dorevia_cash_guard" model="ir.actions.act_window">
        <field name="name">Documents de projection</field>
        <field name="res_model">dorevia.cash.guard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dorevia_cash_guard_search"/>
    </record>

    <record id="action_dorevia_cash_guard_line" model="ir.actions.act_window">
        <field name="name">Flux complémentaires</field>
        <field name="res_model">dorevia.cash.guard.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_dorevia_cash_guard_line_search"/>
    </record>
</odoo>
