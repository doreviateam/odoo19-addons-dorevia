<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dorevia_cash_guard_tree" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.tree</field>
        <field name="model">dorevia.cash.guard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="bank_journal_id"/>
                <field name="alert_threshold"/>
                <field name="initial_balance"/>
                <field name="forecast_final_balance"/>
                <field name="forecast_min_balance"/>
                <field name="risk_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_search" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.search</field>
        <field name="model">dorevia.cash.guard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="bank_journal_id"/>
                <field name="company_id"/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_validated" string="Validé" domain="[('state', '=', 'validated')]"/>
                <filter name="filter_closed" string="Clôturé" domain="[('state', '=', 'closed')]"/>
                <filter name="filter_risk" string="Risque" domain="[('risk_status', '=', 'risk')]"/>
            </search>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_line_tree" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.line.tree</field>
        <field name="model">dorevia.cash.guard.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="projection_date asc,sequence asc,id asc">
                <field name="projection_date"/>
                <field name="sequence"/>
                <field name="budget_post_id"/>
                <field name="label"/>
                <field name="line_type"/>
                <field name="direction"/>
                <field name="projected_amount"/>
                <field name="signed_projected_amount" readonly="1"/>
                <field name="realized_amount"/>
                <field name="signed_realized_amount" readonly="1"/>
                <field name="variance_amount" readonly="1"/>
                <field name="balance_after_line" readonly="1"/>
                <field name="cash_state"/>
            </list>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_line_search" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.line.search</field>
        <field name="model">dorevia.cash.guard.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="budget_post_id"/>
                <field name="guard_id"/>
                <field name="line_type"/>
                <field name="cash_state"/>
                <filter name="filter_planned" string="Prévu" domain="[('line_type', '=', 'planned')]"/>
                <filter name="filter_simulated" string="Simulé" domain="[('line_type', '=', 'simulated')]"/>
                <filter name="filter_reconciled" string="Rapproché" domain="[('cash_state', '=', 'reconciled')]"/>
            </search>
        </field>
    </record>

    <record id="view_dorevia_cash_guard_form" model="ir.ui.view">
        <field name="name">dorevia.cash.guard.form</field>
        <field name="model">dorevia.cash.guard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recompute_projection" type="object" string="Recalculer" class="btn-primary"/>
                    <button name="action_validate" type="object" string="Valider" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Clôturer" invisible="state != 'validated'" groups="dorevia_cash_guard.group_cash_guard_manager"/>
                    <button name="action_reopen" type="object" string="Rouvrir" invisible="state == 'draft'" groups="dorevia_cash_guard.group_cash_guard_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="company_id"/>
                            <field name="responsible_id"/>
                            <field name="bank_journal_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="alert_threshold" readonly="state != 'draft'"/>
                            <field name="risk_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Synthèse">
                        <field name="initial_balance" readonly="1"/>
                        <field name="forecast_final_balance" readonly="1"/>
                        <field name="forecast_min_balance" readonly="1"/>
                        <field name="min_balance_date" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Flux prévisionnels">
                            <field name="line_ids" context="{'default_projection_date': date_from}" readonly="state != 'draft'">
                                <list editable="bottom" default_order="projection_date asc,sequence asc,id asc">
                                    <field name="projection_date"/>
                                    <field name="sequence"/>
                                    <field name="budget_post_id"/>
                                    <field name="label"/>
                                    <field name="line_type"/>
                                    <field name="direction"/>
                                    <field name="projected_amount"/>
                                    <field name="signed_projected_amount" readonly="1"/>
                                    <field name="realized_amount"/>
                                    <field name="signed_realized_amount" readonly="1"/>
                                    <field name="variance_amount" readonly="1"/>
                                    <field name="balance_after_line" readonly="1"/>
                                    <field name="cash_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dorevia_cash_guard" model="ir.actions.act_window">
        <field name="name">Points de trésorerie</field>
        <field name="res_model">dorevia.cash.guard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dorevia_cash_guard_search"/>
    </record>

    <record id="action_dorevia_cash_guard_line" model="ir.actions.act_window">
        <field name="name">Flux prévisionnels</field>
        <field name="res_model">dorevia.cash.guard.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_dorevia_cash_guard_line_search"/>
    </record>
</odoo>
