<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_cash_guard_user" model="res.groups">
        <field name="name">Utilisateur Cash Guard</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cash_guard_manager" model="res.groups">
        <field name="name">Cash Guard Manager</field>
        <field name="implied_ids" eval="[(4, ref('dorevia_cash_guard.group_cash_guard_user'))]"/>
    </record>

    <record id="rule_cash_guard_user_multi_company" model="ir.rule">
        <field name="name">Cash Guard multi-société utilisateur</field>
        <field name="model_id" ref="model_dorevia_cash_guard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dorevia_cash_guard.group_cash_guard_user'))]"/>
    </record>

    <record id="rule_cash_guard_line_user_multi_company" model="ir.rule">
        <field name="name">Cash Guard lignes multi-société utilisateur</field>
        <field name="model_id" ref="model_dorevia_cash_guard_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dorevia_cash_guard.group_cash_guard_user'))]"/>
    </record>

    <record id="rule_cash_guard_week_user_multi_company" model="ir.rule">
        <field name="name">Cash Guard soldes multi-société utilisateur</field>
        <field name="model_id" ref="model_dorevia_cash_guard_week"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dorevia_cash_guard.group_cash_guard_user'))]"/>
    </record>
</odoo>
