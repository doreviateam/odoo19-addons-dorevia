<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_salary_allocation_list" model="ir.ui.view">
        <field name="name">glc.salary.allocation.list</field>
        <field name="model">glc.salary.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="period_date"/>
                <field name="employee_id"/>
                <field name="method"/>
                <field name="allocated_amount"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_glc_salary_allocation_form" model="ir.ui.view">
        <field name="name">glc.salary.allocation.form</field>
        <field name="model">glc.salary.allocation</field>
        <field name="arch" type="xml">
            <form string="Ventilation salariale">
                <header>
                    <button name="action_submit_to_check" type="object" string="Soumettre"
                            invisible="state != 'draft'" class="btn-secondary"/>
                    <button name="action_validate" type="object" string="Valider"
                            invisible="state not in ('draft', 'to_check')" class="btn-primary"/>
                    <button name="action_lock" type="object" string="Verrouiller"
                            invisible="state != 'validated'" class="btn-secondary"/>
                    <button name="action_reset_to_draft" type="object" string="Remettre en brouillon"
                            invisible="state not in ('to_check', 'validated')" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_check,validated,locked"/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not payroll_variance_alert">
                        <strong>Synthèse masse salariale (informatif)</strong>
                        <span class="ms-2">
                            <field name="payroll_variance_message" nolabel="1" readonly="1"/>
                            (<field name="payroll_variance_pct" nolabel="1" readonly="1"/> %)
                        </span>
                    </div>
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="payroll_variance_alert">
                        <strong>Synthèse masse salariale (informatif)</strong>
                        <span class="ms-2">
                            Masse comptable :
                            <field name="accounting_payroll_mass" nolabel="1" readonly="1"/>
                            · Total ventilé validé :
                            <field name="validated_allocated_total" nolabel="1" readonly="1"/>
                            · Écart :
                            <field name="payroll_variance_pct" nolabel="1" readonly="1"/> %
                        </span>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state in ('validated', 'locked')"/>
                            <field name="period_date"
                                   readonly="state in ('validated', 'locked')"/>
                            <field name="employee_id"
                                   readonly="state in ('validated', 'locked')"/>
                            <field name="employee_cost_line_id"
                                   readonly="state in ('validated', 'locked')"/>
                        </group>
                        <group>
                            <field name="method"
                                   readonly="state in ('validated', 'locked')"/>
                            <field name="cost_amount" readonly="1"/>
                            <field name="total_percent" readonly="1"
                                   invisible="method != 'percent'"/>
                            <field name="total_hours" readonly="1"
                                   invisible="method != 'hours'"/>
                            <field name="allocated_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payroll_variance_alert" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="state not in ('validated', 'locked')">
                        <field name="validated_by" readonly="1"/>
                        <field name="validated_date" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Ventilation par activité">
                            <field name="line_ids"
                                   readonly="state in ('validated', 'locked')">
                                <list editable="bottom">
                                    <field name="activity_account_id"/>
                                    <field name="percent"
                                           invisible="parent.method != 'percent'"
                                           column_invisible="parent.method != 'percent'"/>
                                    <field name="hours"
                                           invisible="parent.method != 'hours'"
                                           column_invisible="parent.method != 'hours'"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commentaire">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_glc_salary_allocation" model="ir.actions.act_window">
        <field name="name">Ventilations salariales</field>
        <field name="res_model">glc.salary.allocation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
