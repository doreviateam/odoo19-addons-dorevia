<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_glc_employee_cost_line_list" model="ir.ui.view">
        <field name="name">glc.employee.cost.line.list</field>
        <field name="model">glc.employee.cost.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="period_date"/>
                <field name="employee_id"/>
                <field name="cost_amount"/>
                <field name="reference_hours"/>
                <field name="hourly_cost"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_glc_employee_cost_line_form" model="ir.ui.view">
        <field name="name">glc.employee.cost.line.form</field>
        <field name="model">glc.employee.cost.line</field>
        <field name="arch" type="xml">
            <form string="Coût salarié mensuel">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="employee_id"/>
                            <field name="period_date"/>
                        </group>
                        <group>
                            <field name="cost_amount"/>
                            <field name="reference_hours"/>
                            <field name="hourly_cost" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="source" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_glc_employee_cost_line" model="ir.actions.act_window">
        <field name="name">Coûts salariés mensuels</field>
        <field name="res_model">glc.employee.cost.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
