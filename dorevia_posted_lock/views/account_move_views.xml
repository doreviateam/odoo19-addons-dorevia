<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_posted_lock" model="ir.ui.view">
        <field name="name">account.move.form.dorevia.posted.lock</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button or (move_type == 'out_invoice' and state == 'posted')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
