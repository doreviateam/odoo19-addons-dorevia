<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- /shop : menu fourni par website_sale (éviter doublon « Boutique »). Renommer en « Boutique » depuis le site si besoin. -->
    <record id="menu_ckreyol_espace_pro" model="website.menu">
        <field name="name">Espace pro</field>
        <field name="page_id" ref="ckreyol_page_espace_pro"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">25</field>
    </record>
    <record id="menu_ckreyol_revendeurs" model="website.menu">
        <field name="name">Points de vente</field>
        <field name="page_id" ref="ckreyol_page_revendeurs"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">26</field>
    </record>
    <record id="menu_ckreyol_histoire" model="website.menu">
        <field name="name">Notre histoire</field>
        <field name="page_id" ref="ckreyol_page_notre_histoire"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">27</field>
    </record>
</odoo>
