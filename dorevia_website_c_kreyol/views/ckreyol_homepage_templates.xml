<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ckreyol_homepage_inherit" inherit_id="website.homepage" name="C-Kreyol — accueil e-commerce">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure ckreyol-site">
                <section class="ckreyol-hero pt-5 pb-4">
                    <div class="container-fluid px-lg-5">
                        <div class="row g-0 align-items-stretch flex-column flex-lg-row">
                            <div class="col-lg-6 py-5 px-4 px-lg-5 d-flex flex-column justify-content-center">
                                <p class="ckreyol-label mb-3">Crêperie La Platine — Sainte-Anne, Guadeloupe</p>
                                <h1 class="ckreyol-font-display display-5 fw-normal lh-sm mb-4">
                                    C-Kreyol — produits <em class="ckreyol-accent">au manioc</em>, pensés pour la restauration et l’épicerie fine
                                </h1>
                                <p class="lead text-secondary mb-4">
                                    Crêpes surgelées, biscuits secs, farine et snacking : fabriqués en Guadeloupe,
                                    distribués en France et en Europe auprès des professionnels.
                                </p>
                                <div class="border-top border-secondary-subtle pt-4 mb-4">
                                    <p class="ckreyol-label mb-1 text-muted">Partenaire production</p>
                                    <p class="ckreyol-font-display fs-4 mb-0">La Platine</p>
                                </div>
                                <div class="d-flex flex-column gap-3">
                                    <a href="/espace-professionnels" class="ckreyol-cta-pro text-decoration-none py-3 px-4 d-flex justify-content-between align-items-center">
                                        <span>
                                            <span class="ckreyol-font-mono text-uppercase small d-block opacity-75 mb-1">Professionnel</span>
                                            <span class="ckreyol-font-display fs-5">Espace revendeur &amp; documentation</span>
                                        </span>
                                        <span class="fs-5">→</span>
                                    </a>
                                    <a href="/revendeurs" class="ckreyol-cta-consumer text-decoration-none py-3 px-4 d-flex justify-content-between align-items-center">
                                        <span>
                                            <span class="ckreyol-font-mono text-uppercase small d-block text-muted mb-1">Consommateur</span>
                                            <span class="ckreyol-font-display fs-5">Trouver un point de vente</span>
                                        </span>
                                        <span class="fs-5">→</span>
                                    </a>
                                </div>
                            </div>
                            <div class="col-lg-6 ckreyol-hero-visual d-flex align-items-center justify-content-center p-5">
                                <p class="text-secondary fst-italic text-center mb-0 small">
                                    [Zone visuelle — photos crêpes &amp; biscuits La Platine]
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5 ckreyol-band-sable">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-8 mb-3 mb-lg-0">
                                <h2 class="ckreyol-font-display h2 mb-2">Catalogue professionnel</h2>
                                <p class="text-secondary mb-0">
                                    Parcourez les gammes sur la boutique en ligne : conditionnements, DLC et tarifs selon votre compte (à paramétrer côté Odoo).
                                </p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <a href="/shop" class="btn btn-dark btn-lg px-4">Voir la boutique</a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <h2 class="ckreyol-font-display h3 mb-4 pb-3 border-bottom border-dark">Familles produits</h2>
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-3">
                                <p class="ckreyol-label mb-1">01</p>
                                <h3 class="ckreyol-font-display h5">Crêpes de manioc</h3>
                                <p class="small text-secondary">Surgelées −18 °C — formats restauration.</p>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <p class="ckreyol-label mb-1">02</p>
                                <h3 class="ckreyol-font-display h5">Biscuits</h3>
                                <p class="small text-secondary">Secs, ambiant — coffrets et café gourmand.</p>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <p class="ckreyol-label mb-1">03</p>
                                <h3 class="ckreyol-font-display h5">Farine de manioc</h3>
                                <p class="small text-secondary">Ingrédient B2B — sacs 5 kg / 25 kg.</p>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <p class="ckreyol-label mb-1">04</p>
                                <h3 class="ckreyol-font-display h5">Chips</h3>
                                <p class="small text-secondary">Snacking premium — sans gluten.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5 ckreyol-band-dark text-center">
                    <div class="container py-3">
                        <h2 class="ckreyol-font-display h3 text-white mb-3">Carte des revendeurs</h2>
                        <p class="text-white-50 mx-auto mb-4" style="max-width: 36rem;">
                            Épiceries fines, concept stores et boutiques bio : la liste des points de vente sera publiée ou intégrée ici.
                        </p>
                        <a href="/revendeurs" class="btn btn-outline-light text-uppercase ckreyol-font-mono small px-4">En savoir plus</a>
                    </div>
                </section>

                <section class="py-5 ckreyol-band-sable">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="bg-white border p-4 h-100">
                                    <p class="ckreyol-label text-secondary mb-2">Pour les professionnels</p>
                                    <h3 class="ckreyol-font-display h4 mb-3">Espace professionnel</h3>
                                    <p class="text-secondary small mb-4">
                                        Catalogue complet, tarifs réseau, conditions logistiques et échantillons sur demande.
                                    </p>
                                    <a href="/contactus" class="btn btn-outline-secondary btn-sm text-uppercase ckreyol-font-mono">Contact / devis →</a>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-white border p-4 h-100">
                                    <p class="ckreyol-label text-muted mb-2">Consommateur</p>
                                    <h3 class="ckreyol-font-display h4 mb-3">Une question ?</h3>
                                    <p class="text-secondary small mb-4">
                                        Nous ne vendons pas en direct sur ce canal ; utilisez le formulaire contact pour les messages généraux.
                                    </p>
                                    <a href="/contactus" class="btn btn-outline-secondary btn-sm text-uppercase ckreyol-font-mono">Nous écrire →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
