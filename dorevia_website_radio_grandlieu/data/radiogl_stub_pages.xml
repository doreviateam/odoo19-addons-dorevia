<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vues QWeb (requis : website.page hérite de ir.ui.view via view_id) -->
    <record id="radiogl_view_qui_sommes" model="ir.ui.view">
        <field name="name">Radio GL — Qui sommes-nous</field>
        <field name="key">dorevia_website_radio_grandlieu.page_qui_sommes</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t name="Qui sommes-nous ?" t-name="dorevia_website_radio_grandlieu.page_qui_sommes">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="container py-5">
                            <h1>Qui sommes-nous ?</h1>
                            <p class="lead">
                                Page d’entraînement Odoo — Radio Grand Lieu est une association
                                basée à Saint-Aignan-de-Grand-Lieu (Loire-Atlantique).
                            </p>
                            <p>
                                Contenu de référence sur le site public :
                                <a href="https://radiograndlieu.fr/qui-sommes-nous/" target="_blank" rel="noopener noreferrer">radiograndlieu.fr</a>.
                            </p>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="page_qui_sommes" model="website.page">
        <field name="name">Qui sommes-nous ?</field>
        <field name="url">/qui-sommes-nous</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published">True</field>
        <field name="view_id" ref="radiogl_view_qui_sommes"/>
    </record>

    <record id="radiogl_view_partenaires" model="ir.ui.view">
        <field name="name">Radio GL — Partenaires</field>
        <field name="key">dorevia_website_radio_grandlieu.page_partenaires</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t name="Partenaires" t-name="dorevia_website_radio_grandlieu.page_partenaires">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="container py-5">
                            <h1>Partenaires</h1>
                            <p>Page stub — à compléter ou à lier vers la page officielle des partenaires.</p>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="page_partenaires" model="website.page">
        <field name="name">Partenaires</field>
        <field name="url">/partenaires</field>
        <field name="website_indexed" eval="True"/>
        <field name="is_published">True</field>
        <field name="view_id" ref="radiogl_view_partenaires"/>
    </record>

