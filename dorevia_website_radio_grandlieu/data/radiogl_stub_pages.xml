                            <a class="btn btn-primary" href="https://radiograndlieu.fr/evenements-publics/" target="_blank" rel="noopener noreferrer">Voir les événements (site officiel)</a>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
