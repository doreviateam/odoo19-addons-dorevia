<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- sale.order form: simulation group -->
    <record id="view_order_form_cash_simulation" model="ir.ui.view">
        <field name="name">sale.order.form.cash.simulation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <separator string="Simulation trésorerie"
                           invisible="state not in ('draft', 'sent')"
                           groups="dorevia_cash_guard.group_cash_guard_user"/>
                <field name="cash_simulation_ok"
                       invisible="state not in ('draft', 'sent')"
                       groups="dorevia_cash_guard.group_cash_guard_user"/>
                <field name="cash_simulation_due_date"
                       invisible="not cash_simulation_ok or state not in ('draft', 'sent')"
                       required="cash_simulation_ok"
                       groups="dorevia_cash_guard.group_cash_guard_user"/>
                <field name="cash_simulation_eligible"
                       invisible="not cash_simulation_ok or state not in ('draft', 'sent')"
                       groups="dorevia_cash_guard.group_cash_guard_user"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- sale.order quotation list: optional simulation column -->
    <record id="view_quotation_tree_cash_simulation" model="ir.ui.view">
        <field name="name">sale.order.tree.cash.simulation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="cash_simulation_ok"
                       string="Simulation"
                       optional="hide"
                       groups="dorevia_cash_guard.group_cash_guard_user"/>
            </xpath>
        </field>
    </record>

    <!-- sale.order order list: optional simulation column -->
    <record id="view_order_tree_cash_simulation" model="ir.ui.view">
        <field name="name">sale.order.tree.order.cash.simulation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="cash_simulation_ok"
                       string="Simulation"
                       optional="hide"
                       groups="dorevia_cash_guard.group_cash_guard_user"/>
            </xpath>
        </field>
    </record>

</odoo>
